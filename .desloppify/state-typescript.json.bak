    "review::.::holistic::design_coherence::duplicated_shot_association_workflow::d8cb35d2": {
      "id": "review::.::holistic::design_coherence::duplicated_shot_association_workflow::d8cb35d2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Shot-selector/add-to-shot behavior is duplicated across two lightbox control components, creating drift risk and inconsistent UX behavior.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/shared/components/MediaLightbox/components/ShotSelectorControls.tsx",
          "src/shared/components/MediaLightbox/components/WorkflowControls.tsx",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryActions.ts"
        ],
        "evidence": [
          "Both `ShotSelectorControls` and `WorkflowControls` implement nearly the same `handleAddWithoutPosition` flow: guard `selectedShotId`, call `onAddToShotWithoutPosition`, then trigger secondary tick + optimistic update.",
          "Both render `ShotSelectorWithAdd` with parallel parameter wiring and very similar tick/disabled conditions.",
          "Behavior has already diverged: `ShotSelectorControls` includes jump-to-shot and variant-add flow, while `WorkflowControls` shows the same success tooltip text but lacks that navigation path."
        ],
        "suggestion": "Extract a shared `useShotAssociationControls` hook or a single reusable control component that owns add/jump/tick state transitions and is parameterized only by placement/layout concerns.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-25T13:00:09+00:00",

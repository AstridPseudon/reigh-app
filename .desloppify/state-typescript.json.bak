    "review::.::holistic::design_coherence::timeline_pipeline_bag_overabstraction::49fe8b02": {
      "id": "review::.::holistic::design_coherence::timeline_pipeline_bag_overabstraction::49fe8b02",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Timeline orchestration relies on oversized pipeline-bag interfaces that add indirection without clear ownership boundaries.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/travel-between-images/components/Timeline/hooks/useTimelineOrchestrator.ts",
          "src/tools/travel-between-images/components/Timeline/hooks/useTimelineActionHandlers.ts",
          "src/tools/travel-between-images/components/Timeline/hooks/useTimelineViewportController.ts"
        ],
        "evidence": [
          "`useTimelineOrchestrator` assembles large nested pipeline objects and passes them to `useTimelineActionHandlers` instead of composing focused hooks directly.",
          "`useTimelineActionHandlers` destructures many fields and mostly forwards them into `useUnifiedDrop`, `useTapToMove`, and `useEndpointDrag`, indicating a pass-through abstraction layer.",
          "Viewport and action controller hooks each require broad input bags, increasing cross-hook coupling and making changes require synchronized edits in multiple wrappers."
        ],
        "suggestion": "Replace pipeline-bag inputs with smaller concern-specific hooks invoked directly in the orchestrator (drop, duplicate, tap-to-move, endpoint drag). Keep each hook contract minimal and localize ownership so adding/removing one concern does not force shape changes across all orchestrator layers.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Removed useTimelineActionHandlers pipeline-bag indirection and composed timeline concerns directly in useTimelineOrchestrator (drop interceptors, duplicate placement, tap-to-move, endpoint drag). Also flattened useTimelineViewportController input contract to avoid nested bag coupling.",
      "first_seen": "2026-02-25T20:43:39+00:00",
      "last_seen": "2026-02-25T20:43:39+00:00",
      "resolved_at": "2026-02-25T20:51:58+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually removed the pipeline-bag abstraction and rewired orchestrator composition directly and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T20:51:58+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::design_coherence::segment_slot_mode_responsibility_mix::014395d5": {
      "id": "review::.::holistic::design_coherence::segment_slot_mode_responsibility_mix::014395d5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Segment slot mode hook mixes navigation state machine, domain policy, and UI view-model assembly in one module.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/travel-between-images/components/ShotImagesEditor/hooks/useSegmentSlotMode.ts",
          "src/shared/components/MediaLightbox/hooks/useSharedLightboxState.ts"
        ],
        "evidence": [
          "`useSegmentSlotMode` includes deep-link routing effects (`useLocation`/`useNavigate`), state reset choreography, pair/trailing slot synthesis, structure video overlap resolution, and debounced frame update logic.",
          "The same hook also constructs `SegmentSlotModeData` with many callbacks and rendering-facing fields, coupling domain computation and presentation concerns.",
          "Lightbox-related navigation/state composition is handled in separate shared hooks elsewhere (`useSharedLightboxState`), showing uneven boundary decisions for similar orchestration responsibilities."
        ],
        "suggestion": "Split `useSegmentSlotMode` into: (1) URL/deep-link state synchronizer, (2) segment-pair domain calculator, and (3) presentation adapter that maps domain state to `SegmentSlotModeData`. Keep overlap-resolution policy in a standalone pure module with tests.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Split segment slot responsibilities into dedicated modules: deep-link synchronization (useSegmentSlotDeepLinking), domain builders for slot maps/trailing pair synthesis, and presentation adapter assembly (useSegmentSlotPresentationAdapter). useSegmentSlotMode now orchestrates these boundaries instead of owning all concerns in one module.",
      "first_seen": "2026-02-25T20:43:39+00:00",
      "last_seen": "2026-02-25T20:43:39+00:00",
      "resolved_at": "2026-02-25T20:51:54+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually decomposed segment slot mode into separate deep-link, domain, and presentation modules and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T20:51:54+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::design_coherence::edge_handler_contract_drift::33eb8808": {
      "id": "review::.::holistic::design_coherence::edge_handler_contract_drift::33eb8808",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Supabase edge handlers follow inconsistent runtime/logger/response conventions, weakening a shared handler architecture.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "supabase/functions/revoke-pat/index.ts",
          "supabase/functions/generate-pat/index.ts",
          "supabase/functions/get-completed-segments/index.ts",
          "supabase/functions/get-task-output/index.ts",
          "supabase/functions/_shared/edgeRequest.ts"
        ],
        "evidence": [
          "`revoke-pat` creates `new SystemLogger(...)` after bootstrap instead of using the logger returned by `bootstrapEdgeHandler`, unlike sibling handlers.",
          "Sibling endpoints return different response envelope styles for similar validation/auth failures (`jsonResponse` JSON vs raw text `Response`).",
          "Shared request/runtime utilities exist in `_shared/edgeRequest.ts`, but endpoint implementations still diverge in method/error contract patterns."
        ],
        "suggestion": "Enforce a single edge handler contract: always consume bootstrap logger/runtime, standardize error envelopes, and route response creation through shared helpers. Add a lightweight endpoint template or lint check to prevent logger/response drift in new functions.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Standardized edge handler contracts by using bootstrap logger consistently (revoke-pat), converging get-completed-segments onto jsonResponse envelopes, and aligning PAT handlers and edge runtime error paths with shared conventions.",
      "first_seen": "2026-02-25T20:43:39+00:00",
      "last_seen": "2026-02-25T20:43:39+00:00",
      "resolved_at": "2026-02-25T20:52:02+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually normalized these edge handlers to shared logger/response conventions and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T20:52:02+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::design_coherence::task_param_contract_scattered::f132cfa6": {
      "id": "review::.::holistic::design_coherence::task_param_contract_scattered::f132cfa6",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Task-parameter extraction and precedence logic are duplicated across edge and app layers with no shared contract authority.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "supabase/functions/complete_task/params.ts",
          "src/shared/lib/tasks/individualTravelSegment.ts",
          "src/shared/lib/tasks/imageGeneration.ts"
        ],
        "evidence": [
          "`complete_task/params.ts` maintains many path-fallback extractors (`extractFromParams`, `extractShotAndPosition`, `extractBasedOn`) for evolving payload shapes.",
          "Client task builders in `individualTravelSegment.ts` and `imageGeneration.ts` maintain separate precedence/normalization logic (`resolveByPrecedence`, parser helpers, mode-specific filtering).",
          "The same domain concepts (shot IDs, orchestrator refs, optional field precedence) are encoded in multiple places, raising drift risk when payload shape changes."
        ],
        "suggestion": "Define a versioned shared task-params contract (schema + generated accessors) consumed by both edge functions and client task builders. Centralize fallback path lists and precedence rules in one module/package and deprecate ad hoc extractors.",

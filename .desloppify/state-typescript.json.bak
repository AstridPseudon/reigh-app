    "review::.::holistic::error_consistency::edge_error_contract_drift::e3fd635f": {
      "id": "review::.::holistic::error_consistency::edge_error_contract_drift::e3fd635f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Edge functions handling related task completion flows use different error contracts, which makes downstream behavior and recovery unpredictable.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/calculate-task-cost/index.ts",
          "supabase/functions/complete_task/generation.ts",
          "supabase/functions/complete_task/orchestrator.ts"
        ],
        "evidence": [
          "`calculate-task-cost` consistently returns typed `edgeErrorResponse` codes and statuses for operational failures.",
          "`complete_task/generation.ts` catches and rethrows raw errors after `console.error`, without converting to a shared transport shape.",
          "`complete_task/orchestrator.ts` logs failed billing (`console.error` when `triggerCostCalculation` fails) but continues completion flow, creating a non-uniform failure policy compared with other guarded paths."
        ],
        "suggestion": "Adopt one shared edge error strategy for completion/billing modules (typed error envelope + centralized logger), and route billing failure into explicit retry/failed-state signaling instead of log-only handling.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T18:35:23+00:00",
      "last_seen": "2026-02-24T18:35:23+00:00",
      "resolved_at": "2026-02-24T18:44:55+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::error_consistency::mixed_error_wrapping_in_hooks::0f09d7bb": {
      "id": "review::.::holistic::error_consistency::mixed_error_wrapping_in_hooks::0f09d7bb",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Hook-layer data mutations mix raw `Error` construction and normalized rethrow patterns, causing uneven context fidelity and UX behavior.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/hooks/useGenerationMutations.ts",
          "src/shared/hooks/useTasks.ts",
          "src/tools/travel-between-images/components/ShotImagesEditor/hooks/useShotImagesEditorCallbacks.ts"
        ],
        "evidence": [
          "`useGenerationMutations` frequently throws new string-formatted `Error` instances from Supabase results before later `onError` handling, losing structured original error metadata.",
          "`useTasks` catch path notifies freshness and rethrows raw `error` directly, while sibling codepaths in the same subsystem normalize through shared handlers.",
          "`useShotImagesEditorCallbacks` uses `handleAndRethrow` for adapter failures, preserving a normalized error flow that differs from the raw-throw pattern in other hooks."
        ],
        "suggestion": "Define a hook-layer convention: normalize at boundary (e.g., `handleAndRethrow` or shared mapper) and avoid ad-hoc `new Error(...)` wrapping unless adding machine-readable fields; update mutation/query hooks to follow the same propagation policy.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T18:35:23+00:00",
      "last_seen": "2026-02-24T18:35:23+00:00",

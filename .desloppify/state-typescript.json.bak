      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Compatibility migration governance is inconsistent between type-shim and Supabase shim contracts.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "README.md",
          "src/integrations/supabase/client.ts",
          "src/types/generationAndShots.ts"
        ],
        "evidence": [
          "README.md provides explicit enforcement for the removed `@/types/shots` alias via `npm run check:shots-shim-usage`.",
          "`src/integrations/supabase/client.ts` includes deprecation metadata for legacy `supabase` export but no analogous automated gate to block new legacy imports or prove readiness for removal."
        ],
        "suggestion": "Add a CI quality gate (lint/script) that forbids new `import { supabase } from '@/integrations/supabase/client'` usages and tracks remaining call sites, matching the documented strict-shim governance pattern used for type aliases.",
        "reasoning": ""

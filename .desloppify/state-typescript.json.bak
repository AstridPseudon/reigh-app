    "review::.::holistic::error_consistency::complete_task_generation_update_silent_failure::af077ab3": {
      "id": "review::.::holistic::error_consistency::complete_task_generation_update_silent_failure::af077ab3",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Generation completion path performs an unchecked DB update that can fail silently",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/complete_task/generation.ts",
          "supabase/functions/complete_task/orchestrator.ts"
        ],
        "evidence": [
          "`handleRegeneration` updates `tasks.generation_created` but does not read or branch on `{ error }` from Supabase.",
          "Sibling orchestration updates in the same subsystem check errors and throw `CompletionError` with metadata."
        ],
        "suggestion": "Capture `{ error }` from the `generation_created` update in `handleRegeneration`; if present, throw `CompletionError` (or `toCompletionError`) with task id/context metadata to keep completion writes fail-fast and traceable.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

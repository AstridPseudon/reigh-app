    "review::.::holistic::authorization_consistency::privileged_completion_invariant_missing::a563bd67": {
      "id": "review::.::holistic::authorization_consistency::privileged_completion_invariant_missing::a563bd67",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Privileged completion modules rely on implicit caller trust instead of explicit auth invariant",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "supabase/functions/calculate-task-cost/index.ts",
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/complete_task/generation.ts"
        ],
        "evidence": [
          "`calculate-task-cost` enforces `authenticateRequest(...)` and rejects non-service-role callers (`service_role_required`).",
          "`complete_task` orchestration/generation modules perform direct `tasks` updates and generation routing but have no explicit role/actor assertion at their boundary; they depend on upstream caller behavior rather than a local invariant."
        ],
        "suggestion": "Standardize privileged-edge authorization by passing a validated auth context (e.g., `isServiceRole: true`) into completion functions and asserting it in shared entry wrappers, so all sensitive edge flows fail closed if wired from an unauthenticated/incorrect handler.",
        "reasoning": ""
      },
      "status": "auto_resolved",

    "review::.::holistic::cross_module_architecture::settings_queue_reenqueue_churn::f67393e2": {
      "id": "review::.::holistic::cross_module_architecture::settings_queue_reenqueue_churn::f67393e2",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Global settings write queue can enqueue duplicate flush work for the same target under immediate writes, causing avoidable repeated writes and coordination churn.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/settingsWriteQueue.ts",
          "src/shared/hooks/useToolSettings.ts",
          "src/shared/settings/hooks/useDebouncedSettingsSave.ts"
        ],
        "evidence": [
          "`scheduleFlush()` always pushes to `flushQueue` without checking if target is already queued/in-flight.",
          "`processQueue()` removes target from `pendingByTarget` before awaiting `writeFunction`, so a new immediate write to same key creates a second pending entry while first is still running.",
          "Multiple call sites use `'immediate'` mode (`useDebouncedSettingsSave`, `useUserUIState`, `useVideoRegenerateMode`), increasing likelihood of this path."
        ],
        "suggestion": "Add per-target queue state (`queued`/`inFlight`) and keep target registered until write settles; coalesce immediate writes into the active target entry and only schedule one flush token per target.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-02T11:53:31+00:00",
      "last_seen": "2026-03-02T11:53:31+00:00",

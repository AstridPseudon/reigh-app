    "review::.::holistic::error_consistency::calc_task_cost_malformed_json_500::11edc7df": {
      "id": "review::.::holistic::error_consistency::calc_task_cost_malformed_json_500::11edc7df",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Malformed request bodies are misclassified as internal server errors in calculate-task-cost.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/calculate-task-cost/index.ts",
          "supabase/functions/complete_task/generation.ts"
        ],
        "evidence": [
          "In `supabase/functions/calculate-task-cost/index.ts`, `const { task_id } = await req.json();` is inside a top-level try block; JSON parse failures flow to the catch that returns `errorResponse('internal_server_error', ..., 500)`.",
          "The same handler otherwise returns explicit categorized client errors (`missing_task_id`, `method_not_allowed`, auth failures), so malformed JSON currently gets a less accurate and inconsistent classification."
        ],
        "suggestion": "Handle JSON parsing in a dedicated guard (`try { body = await req.json(); } catch { return errorResponse('invalid_json', 'Request body must be valid JSON', 400); }`) before main business logic, keeping 500s reserved for true server faults.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Added dedicated JSON parse/body-shape guard in calculate-task-cost; malformed payloads now return invalid_json 400.",

      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Lightbox split introduced adapter-heavy seams that remap the same state repeatedly.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/components/MediaLightbox/ImageLightbox.tsx",
          "src/shared/components/MediaLightbox/hooks/useSharedLightboxState.ts",
          "src/shared/components/MediaLightbox/hooks/useVideoLightboxRenderModel.tsx"
        ],
        "evidence": [

      "summary": "Lightbox and inline-edit orchestration rely on high-cost pass-through model layers.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "src/shared/components/MediaLightbox/VideoLightbox.tsx",

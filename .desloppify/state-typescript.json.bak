    "review::.::holistic::error_consistency::generation_completion_error_shape_not_structured::51af742d": {
      "id": "review::.::holistic::error_consistency::generation_completion_error_shape_not_structured::51af742d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Generation completion converts heterogeneous failures into a generic error string envelope instead of preserving structured failure metadata used elsewhere in completion/billing flows.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/complete_task/generation.ts",
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/calculate-task-cost/index.ts"
        ],
        "evidence": [
          "`createGenerationFromTask()` catches all errors and rethrows `new Error('[GenMigration] ...')` (`supabase/functions/complete_task/generation.ts:259-268`), collapsing domain error kinds into message text.",
          "Adjacent completion logic has explicit machine-readable policy objects and fields (`status`, `recoverable`, `error_code`, reconciliation flags) in orchestrator billing handling (`supabase/functions/complete_task/orchestrator.ts:67-115,579-585`).",
          "Cost calculation endpoint similarly returns explicit `errorResponse` codes (`subtask_query_failed`, `cost_record_check_failed`) rather than message-only errors (`supabase/functions/calculate-task-cost/index.ts:301-309,352-356`)."
        ],
        "suggestion": "Introduce a shared completion error envelope (code + recoverable + context + cause) for `complete_task` modules and throw/return that type from generation routing instead of generic `Error` strings.",
        "reasoning": ""
      },
      "status": "auto_resolved",

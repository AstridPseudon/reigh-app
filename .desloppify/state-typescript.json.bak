    "review::.::holistic::api_surface_coherence::lightbox_contract_fragmentation::6e9f41d6": {
      "id": "review::.::holistic::api_surface_coherence::lightbox_contract_fragmentation::6e9f41d6",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Lightbox callback contracts are redefined across layers with conflicting async and return-shape semantics.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/shared/components/MediaGallery/components/MediaGalleryLightbox.tsx",

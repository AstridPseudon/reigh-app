    "review::.::holistic::cross_module_architecture::legacy_compatibility_hubs_blur_boundaries::4734cbf0": {
      "id": "review::.::holistic::cross_module_architecture::legacy_compatibility_hubs_blur_boundaries::4734cbf0",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Multiple compatibility facades preserve legacy paths and concentrate coupling in shared hubs.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/hooks/useMobile.tsx",
          "src/types/generationAndShots.ts"
        ],
        "evidence": [
          "`src/integrations/supabase/client.ts` exports deprecated `supabase` proxy and fallback lazy init path instead of hard bootstrap-only access.",
          "`src/shared/hooks/useMobile.tsx` is explicitly marked deprecated but still acts as active compatibility entrypoint for mobile APIs.",
          "`src/types/generationAndShots.ts` is a canonical barrel re-export, keeping broad cross-module dependence on a central alias surface."
        ],
        "suggestion": "Run an explicit migration to direct module imports, then remove these compatibility facades behind a dated cleanup milestone; enforce with lint/import rules banning the deprecated entrypoints.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

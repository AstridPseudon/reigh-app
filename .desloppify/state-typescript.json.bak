    "review::.::holistic::cross_module_architecture::global_error_presenter_runtime_singleton_coupling::4c022779": {
      "id": "review::.::holistic::cross_module_architecture::global_error_presenter_runtime_singleton_coupling::4c022779",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Global error presenter wiring creates hidden runtime coupling across modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "README.md"
        ],
        "evidence": [
          "handleError.ts `setErrorPresenter` mutates shared notifier state via `configureErrorNotifier`, so behavior depends on global setup order.",
          "The same file is a high-import shared facade, so a mutable singleton notifier affects many unrelated modules implicitly.",
          "README governance contracts document Supabase/cn/shim policies but no explicit runtime contract for global error presenter lifecycle, increasing implicit coupling risk."
        ],
        "suggestion": "Replace global presenter mutation with explicit dependency injection at app boundary (provider/context or passed notifier), and keep `handleError` as pure normalization/logging API with notifier wiring owned by one bootstrap module.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

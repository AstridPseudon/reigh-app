    "review::.::holistic::low_level_elegance::state_sync_choreography_in_lightbox::c45c3cf3": {
      "id": "review::.::holistic::low_level_elegance::state_sync_choreography_in_lightbox::c45c3cf3",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Lightbox internals rely on manual mirrored state and cache subscription choreography",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "src/shared/components/MediaGallery/components/MediaGalleryLightbox.tsx",
          "src/shared/components/MediaGalleryItem/components/ShotActions.tsx"
        ],
        "evidence": [
          "MediaGalleryLightbox keeps `lightboxSelectedShotId` local state, resets it from parent in effect and close-path callbacks, then rethreads it through adapter callbacks.",
          "The same module subscribes directly to React Query cache events and increments a version counter to force recomputation (`void cacheVersion`).",
          "ShotActions depends on parallel local selector/open state contracts, showing boundary friction between gallery and lightbox state ownership."
        ],
        "suggestion": "Introduce a dedicated `useLightboxShotSelection`/`useLightboxStarState` controller that owns synchronization semantics and exposes a stable API to both lightbox and shot-action UI, removing manual cache-version forcing and duplicated shot-selection transitions.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Service-layer APIs in the same workflow mix `OperationResult`, thrown exceptions, and fallback-return contracts, forcing callers to handle incompatible error shapes.",

    "review::.::holistic::api_surface_coherence::mixed_result_envelopes_across_services::0b6ca540": {
      "id": "review::.::holistic::api_surface_coherence::mixed_result_envelopes_across_services::0b6ca540",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Service APIs expose incompatible success/failure shapes, forcing per-call adapters.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "supabase/functions/_shared/edgeOperation.ts",
          "src/tools/travel-between-images/components/ShotEditor/services/generateVideoService.ts",
          "src/shared/lib/media/safePlay.ts",
          "src/shared/hooks/useTaskStatusCounts.ts"
        ],
        "evidence": [
          "`edgeOperation` defines a discriminated union with `ok: true/false`, `errorCode`, and `recoverable`.",
          "`generateVideoService` returns `{ success: boolean, error?: string }` and drops structured error metadata in `failureResult`.",
          "`safePlay` returns only `Promise<boolean>`, so callers cannot inspect reason/category for playback failures.",

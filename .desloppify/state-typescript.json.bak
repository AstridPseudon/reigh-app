    "review::.::holistic::cross_module_architecture::import_time_governance_on_hot_hubs::ef4068f5": {
      "id": "review::.::holistic::cross_module_architecture::import_time_governance_on_hot_hubs::ef4068f5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Governance policy lookup runs at import time in high-fan-in core modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "src/integrations/supabase/legacy/legacySupabaseFacade.ts"
        ],
        "evidence": [
          "`handleError.ts` computes `runtimeErrorAliasPolicy` at module load via `getDeprecationPolicy(...)`.",
          "`legacySupabaseFacade.ts` computes `legacySupabaseFacadePolicy` at module load via `getDeprecationPolicy(...)`.",
          "Both files are listed as heavily imported hubs in the packet context, so import-time coupling amplifies startup and boundary fragility."
        ],
        "suggestion": "Move governance resolution behind call-time boundaries (inside deprecated functions) or inject policy from a dedicated governance adapter. Keep hot-path runtime helpers free of governance imports to avoid global initialization coupling.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

    "review::.::holistic::api_surface_coherence::ignored_abort_signal_in_settings_api::ca24c7b6": {
      "id": "review::.::holistic::api_surface_coherence::ignored_abort_signal_in_settings_api::ca24c7b6",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Settings update API advertises cancellation but silently ignores the passed AbortSignal.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/shared/hooks/useToolSettings.ts",
          "src/shared/lib/settingsWriteQueue.ts"
        ],
        "evidence": [
          "`updateToolSettingsSupabase(params, _signal, mode)` accepts a signal parameter but never threads it anywhere (`src/shared/hooks/useToolSettings.ts:150-163`).",
          "`useToolSettings.update` creates AbortControllers and passes `controller.signal` into the mutation path (`src/shared/hooks/useToolSettings.ts:423-441`), implying callers expect cancellation to be meaningful.",
          "Queue/write layer (`QueuedWrite`, `enqueueSettingsWrite`) has no signal field and cannot cancel in-flight/pending writes (`src/shared/lib/settingsWriteQueue.ts:17-22,133-174`)."
        ],
        "suggestion": "Make the contract honest in one direction: either remove the signal parameter and abort-controller plumbing from callers, or add cancellation support end-to-end (include signal in queued write payload and enforce abort checks before flush/write execution).",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Restored cancellation contract: updateToolSettingsSupabase now supports legacy (params, signal, mode) and mode-only signatures, forwards AbortSignal through queued writes, queue rejects already-aborted writes, and raw settings writes attach/observe abort signals. Updated immediate-mode call sites and added queue/hook tests.",
      "first_seen": "2026-03-02T12:44:18+00:00",
      "last_seen": "2026-03-02T12:44:18+00:00",
      "resolved_at": "2026-03-02T13:30:05+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Restored cancellation contract: updateToolSettingsSupabase now supports legacy (params, signal, mode) and mode-only signatures, forwards AbortSignal through queued writes, queue rejects already-aborted writes, and raw settings writes attach/observe abort signals. Updated immediate-mode call sites and added queue/hook tests. and I am not gaming the score.",
        "attested_at": "2026-03-02T13:30:05+00:00",
        "scan_verified": false

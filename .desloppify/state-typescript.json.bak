    "review::.::holistic::design_coherence::panes_context_overloaded_responsibility::50f233fd": {
      "id": "review::.::holistic::design_coherence::panes_context_overloaded_responsibility::50f233fd",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Pane context combines persistence policy, device-specific lock rules, runtime visibility, dimensions, and active-task selection in one provider.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/shared/contexts/PanesContext.tsx",
          "src/shared/components/TasksPane/TasksPane.tsx",
          "src/shared/components/PaneControlTab.tsx"
        ],
        "evidence": [
          "`PanesContextType` exposes many fields spanning unrelated concerns (locks, open states, dimensions, active task id, reset behavior).",
          "`createPaneLockSetter` performs both state mutation and persistence policy branching (`isMobile`/`isTablet`/`isSmallMobile`) in the same closure.",
          "`TasksPane` still contains lock/open synchronization logic (`onToggleLock`, `onOpenChange`) that partially duplicates context intent, indicating boundary leakage."
        ],
        "suggestion": "Split context into focused providers: `PaneLockPolicyContext`, `PaneLayoutContext`, and `PaneSelectionContext`. Keep persistence and device policy in a dedicated hook consumed by lock policy provider to reduce cross-cutting coupling.",
        "reasoning": ""
      },
      "status": "auto_resolved",

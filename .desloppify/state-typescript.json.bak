    "review::.::holistic::design_coherence::join_clips_autoplay_listener_leak::dca24c7b": {
      "id": "review::.::holistic::design_coherence::join_clips_autoplay_listener_leak::dca24c7b",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Video play listeners are added per clip without valid React cleanup, causing leaked handlers.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/join-clips/hooks/useClipManager.ts",
          "src/tools/join-clips/pages/JoinClipsPage.tsx"
        ],
        "evidence": [
          "In `useClipManager` autoplay effect, `clips.forEach(...)` adds `video.addEventListener('play', preventPlay)` and returns cleanup from inside the `forEach` callback; React ignores those inner returns, so listeners are never removed.",
          "This hook is mounted by `JoinClipsPage`, so each clip list refresh can accumulate stale `play` handlers on reused DOM nodes."
        ],
        "suggestion": "Refactor autoplay prevention into a dedicated effect that tracks attached elements and returns a single top-level cleanup function removing every registered listener (or push this into `SortableClip` with element-local cleanup).",
        "reasoning": ""
      },
      "status": "auto_resolved",

    "review::.::holistic::low_level_elegance::manual_state_mirroring_in_inline_edit::0125017f": {
      "id": "review::.::holistic::low_level_elegance::manual_state_mirroring_in_inline_edit::0125017f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Inline edit state is manually mirrored into multiple large objects, creating fragile local wiring.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "src/tools/edit-images/hooks/useInlineEditState.ts",
          "src/tools/edit-images/components/InlineEditView.tsx"
        ],
        "evidence": [
          "`buildInlineEditStateModels` maps dozens of fields from hook outputs into `inpaintingState`, `generationState`, and `imageEditValue`, repeating many references and setters.",
          "The returned API includes placeholder constants (`isFlippedHorizontally: false`, `isSaving: false`) in `imageEditValue`, which makes the local contract broader than actual behavior and easier to misuse.",
          "`InlineEditView` consumes this broad shape and forwards it wholesale to `ImageEditProvider` and `EditModePanel`, amplifying coupling to field-by-field wiring."
        ],
        "suggestion": "Replace manual mirroring with smaller typed selectors/factories per consumer (`canvasModel`, `panelModel`, `providerModel`) and remove non-functional placeholder fields from exposed state contracts.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Removed wholesale state-bag forwarding in InlineEditView by introducing explicit canvas/sidebar view models (InlineEditCanvasModel, InlineEditSidebarModel) and passing only concern-specific slices to children. This narrows local wiring contracts and reduces fragile field-by-field propagation from the inline edit state surface.",
      "first_seen": "2026-02-25T17:35:53+00:00",
      "last_seen": "2026-02-25T17:35:53+00:00",
      "resolved_at": "2026-02-25T19:19:45+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,

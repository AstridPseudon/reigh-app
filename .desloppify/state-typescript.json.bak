    "review::.::holistic::design_coherence::state_management_relies_on_localized_boolean_accumulation::d3a77fa3": {
      "id": "review::.::holistic::design_coherence::state_management_relies_on_localized_boolean_accumulation::d3a77fa3",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Boolean/state accumulation in interaction-heavy components increases change risk.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/travel-between-images/components/VideoShotDisplay.tsx",
          "src/tools/travel-between-images/components/Timeline/hooks/useTimelineOrchestrator.ts",
          "src/pages/Home/components/panes/PhilosophyPane.tsx"
        ],
        "evidence": [
          "`VideoShotDisplay` keeps many local flags (`isEditingName`, `isDeleteDialogOpen`, `isVideoModalOpen`, `showVideo`, `isFinalVideoLightboxOpen`, `isSelectedForAddition`, `skipConfirmationChecked`) that interact across handlers.",
          "`useTimelineOrchestrator` tracks multiple interaction flags and refs (`showVideoBrowser`, `isUploadingStructureVideo`, drag/end refs, endpoint drag refs, pending states), creating dense coupling between concerns.",
          "`PhilosophyPane` combines multiple media state sets/refs and synchronization effects that coordinate open/close/video lifecycle behavior."
        ],
        "suggestion": "Replace ad-hoc flag growth with explicit reducer/state-machine models per feature area (shot card state, timeline interaction state, philosophy media lifecycle) so transitions are centralized and easier to validate.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Replaced scattered UI booleans with reducer-backed state in VideoShotDisplay and centralized timeline ui-state handling via a dedicated controller hook.",
      "first_seen": "2026-02-25T15:06:26+00:00",
      "last_seen": "2026-02-25T15:06:26+00:00",
      "resolved_at": "2026-02-25T15:29:38+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,

    "review::.::holistic::design_coherence::tasks_pane_boundary_blur::1293f972": {
      "id": "review::.::holistic::design_coherence::tasks_pane_boundary_blur::1293f972",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Tasks pane component still bundles data orchestration and rendering concerns",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/shared/components/TasksPane/TasksPane.tsx",
          "src/shared/components/TasksPane/TaskList.tsx",
          "src/shared/contexts/PanesContext.tsx"
        ],
        "evidence": [
          "`TasksPane` manages filter/session persistence, pagination, status aggregation, optimistic cancellation updates, sliding-pane lifecycle, and lightbox handoff in one component (`TasksPane.tsx:62-300`).",
          "It directly mutates query cache with cancellation logic while also owning pane UI states (`TasksPane.tsx:245-291`).",
          "`PanesContext` already centralizes pane lock/open behavior (`PanesContext.tsx:6-224`), but `TasksPane` still carries significant pane-state choreography, indicating boundary overlap."
        ],
        "suggestion": "Move task-data orchestration (filters, counts, cancellation optimistic updates, page scope) into a dedicated controller hook/service and leave `TasksPane` as a presentational shell. Keep pane lifecycle interactions behind a narrow adapter to `PanesContext`.",
        "reasoning": ""
      },
      "status": "auto_resolved",

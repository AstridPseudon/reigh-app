    "review::.::holistic::cross_module_architecture::realtime_reconnect_dual_orchestration_race::568148f6": {
      "id": "review::.::holistic::cross_module_architecture::realtime_reconnect_dual_orchestration_race::568148f6",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Realtime reconnect is orchestrated by two paths, creating race-prone concurrent reconnect attempts.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/realtime/RealtimeConnection.ts",
          "src/shared/realtime/requestRealtimeReconnect.ts",
          "src/integrations/supabase/reconnect/ReconnectScheduler.ts",
          "src/integrations/supabase/auth/AuthStateManager.ts"
        ],
        "evidence": [
          "`handleSubscribeFailure()` in `RealtimeConnection` both schedules local retry (`scheduleReconnect`) and emits a scheduler request (`requestRealtimeReconnect`).",
          "`handleAuthHeal()` immediately calls `doConnect()` when state is `reconnecting/failed`, but does not clear existing reconnect timers first.",
          "Scheduler coalescing/debounce does not prevent `RealtimeConnection` local timer from firing later, so two reconnect attempts can run close together on the same connection state."
        ],
        "suggestion": "Choose one reconnect orchestrator as source of truth. Either: (1) keep retries entirely in `RealtimeConnection` and remove scheduler-triggered reconnect for subscribe failures, or (2) move retry scheduling fully into `ReconnectScheduler` and make `RealtimeConnection` react only to scheduler events after clearing pending local timers. Add a single-flight guard (connection attempt token) to reject stale concurrent reconnect attempts.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Made RealtimeConnection the sole retry orchestrator for subscribe failures; removed scheduler-triggered retry on subscribe failure; added connect-attempt token + single-flight guard to drop stale reconnect attempts and cancel stale scheduled retries when auth-heal starts a new attempt; added regression tests for deduped concurrent connect and stale-timer cancellation.",
      "first_seen": "2026-03-02T12:39:56+00:00",
      "last_seen": "2026-03-02T12:39:56+00:00",
      "resolved_at": "2026-03-02T13:54:58+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Made RealtimeConnection the sole retry orchestrator for subscribe failures; removed scheduler-triggered retry on subscribe failure; added connect-attempt token + single-flight guard to drop stale reconnect attempts and cancel stale scheduled retries when auth-heal starts a new attempt; added regression tests for deduped concurrent connect and stale-timer cancellation. and I am not gaming the score.",
        "attested_at": "2026-03-02T13:54:58+00:00",

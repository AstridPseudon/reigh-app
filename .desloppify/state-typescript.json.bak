    "review::.::holistic::design_coherence::lora_state_machine_coupling::9d895a19": {
      "id": "review::.::holistic::design_coherence::lora_state_machine_coupling::9d895a19",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "LoRA management conflates UI state, persistence policy, and domain actions, producing hard-to-predict state transitions.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/shared/hooks/useLoraManager.tsx",
          "src/shared/components/LoraSelectorModal/LoraSelectorModal.tsx",
          "src/tools/travel-between-images/components/ShotEditor/hooks/useLoraSync.tsx"
        ],
        "evidence": [
          "`useLoraManager` owns selection rules, duplicate cleanup, persistence, trigger-word prompt mutation, save feedback UI state, and render helper output (`renderHeaderActions`) in a single hook.",
          "`LoraSelectorModal` manages tab/edit/filter/pagination state and performs render-time synchronization using ref comparisons with `setState` inside render path, coupling prop changes to implicit UI transitions.",
          "`useLoraSync` exists as another synchronization layer, indicating cross-module state ownership is fragmented and requires glue hooks."
        ],
        "suggestion": "Split LoRA domain state (selection + validation), persistence adapter, and UI presentation state into separate hooks; move render-time synchronization to effect-driven reducers with explicit transition actions.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": null,
      "first_seen": "2026-02-25T19:24:10+00:00",
      "last_seen": "2026-02-25T19:24:10+00:00",
      "resolved_at": "2026-02-25T19:50:09+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually removed render-time LoRA modal sync, made useLoraSync a thin adapter over useLoraManager, and added controlled-selection support to unify LoRA state ownership, and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T19:50:09+00:00",
        "scan_verified": false
      }
    },

    "review::.::holistic::error_consistency::auth_storage_failure_downgraded_to_normal_flow::2082d36b": {
      "id": "review::.::holistic::error_consistency::auth_storage_failure_downgraded_to_normal_flow::2082d36b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Auth-related localStorage failures are logged but converted into normal-flow fallbacks, hiding state-corruption signals from callers.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/app/routes.tsx",
          "src/pages/Home/hooks/useDiscordSignIn.ts",
          "src/pages/Home/hooks/auth/useAuthReferralFinalize.ts"
        ],
        "evidence": [
          "`hasStoredSession()` catches storage errors and returns `false`, forcing unauthenticated redirect semantics without propagating failure (`src/app/routes.tsx:41-49`).",
          "`useDiscordSignIn()` catches `localStorage.setItem` errors, logs via `handleError`, then continues OAuth startup (`src/pages/Home/hooks/useDiscordSignIn.ts:10-19`).",
          "Sibling auth flow `useAuthReferralFinalize()` uses structured `OperationResult` for failure reporting (`src/pages/Home/hooks/auth/useAuthReferralFinalize.ts:18-53`), creating mixed contracts inside auth-adjacent flows."
        ],
        "suggestion": "Standardize auth-storage boundary handling: return a typed recoverable error/result (e.g., `operationFailure` with `storage_unavailable`) from both route/session probing and OAuth intent caching, and let callers decide whether to continue degraded flow or block with explicit UX.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-24T21:15:44+00:00",

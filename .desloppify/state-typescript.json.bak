    "review::.::holistic::mid_level_elegance::lightbox_forked_render_model_seam::47d5c2fa": {
      "id": "review::.::holistic::mid_level_elegance::lightbox_forked_render_model_seam::47d5c2fa",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Image and video lightbox flows still maintain forked render-model assembly contracts, which increases drift and integration blast radius.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/components/MediaLightbox/ImageLightbox.tsx",
          "src/shared/components/MediaLightbox/hooks/useVideoLightboxRenderModel.tsx",
          "src/shared/components/MediaLightbox/components/layouts/LightboxLayout.tsx",
          "src/shared/components/MediaLightbox/VideoLightbox.tsx"
        ],
        "evidence": [
          "Both branches independently construct broad memoized seam objects (`lightboxStateValue`, `layoutProps`) and then feed the same layout shell.",
          "Image flow owns local environment/shared-state/render assembly; video flow does equivalent assembly through separate controller/render-model hooks.",
          "Shared layout depends on a wide context contract, so any contract change must be mirrored across both assembly paths."
        ],
        "suggestion": "Introduce one canonical lightbox controller contract (core/media/variants/navigation/workflow/controls) with shared builders for common sections, then keep image/video-only fields in narrow extension objects consumed by `LightboxLayout`.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T00:02:15+00:00",
      "last_seen": "2026-02-25T00:02:15+00:00",
      "resolved_at": "2026-02-25T00:08:11+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::mid_level_elegance::task_creation_contract_double_cast::76db585e": {
      "id": "review::.::holistic::mid_level_elegance::task_creation_contract_double_cast::76db585e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Individual travel-segment task creation still bypasses the typed task-input seam with a double cast when reading resolution.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/lib/tasks/individualTravelSegment.ts",
          "src/shared/lib/tasks/travelBetweenImages/payloadBuilder.ts",
          "supabase/functions/complete_task/generation.ts"
        ],
        "evidence": [
          "`createIndividualTravelSegmentTask` reads `parsed_resolution_wh` as `asString((params as unknown as Record<string, unknown>).parsed_resolution_wh)`.",
          "The same module and adjacent task modules already use parser helpers (`toRecordOrEmpty`, `asString`, payload snapshots/contracts) for boundary normalization.",
          "This cast sidesteps compile-time shape guarantees and can silently hide contract drift between task creation and completion readers."
        ],
        "suggestion": "Remove the cast by adding `parsed_resolution_wh?: string` to the segment input type (or by reading from a normalized record built once), and standardize this resolution extraction through one shared reader utility used by task creators.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T00:02:15+00:00",
      "last_seen": "2026-02-25T00:02:15+00:00",
      "resolved_at": "2026-02-25T00:08:11+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::mid_level_elegance::inline_edit_parallel_integration_surface::d174d5e0": {
      "id": "review::.::holistic::mid_level_elegance::inline_edit_parallel_integration_surface::d174d5e0",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Inline edit creates a third integration seam by reassembling lightbox editing primitives outside the main lightbox controller path.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/tools/edit-images/hooks/useInlineEditState.ts",
          "src/tools/edit-images/components/InlineEditView.tsx",
          "src/shared/components/MediaLightbox/ImageLightbox.tsx",
          "src/shared/components/MediaLightbox/components/layouts/LightboxLayout.tsx"
        ],
        "evidence": [
          "`useInlineEditState` orchestrates many hooks sourced from `MediaLightbox/hooks` (upscale, inpainting, magic edit, reposition, img2img, settings sync).",
          "`InlineEditView` directly composes `MediaDisplayWithCanvas`, control groups, and `EditModePanel`, duplicating layout/integration responsibilities also present in lightbox flows.",
          "This produces three active handoff surfaces for similar edit behavior (image lightbox, video lightbox, inline edit), increasing maintenance and behavior skew risk."
        ],
        "suggestion": "Extract a shared image-edit surface controller + presenter contract (mode state, commands, derived UI model) and have both inline edit and image lightbox consume it, leaving only container-specific layout wrappers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T00:02:15+00:00",
      "last_seen": "2026-02-25T00:02:15+00:00",

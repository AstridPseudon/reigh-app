    "review::.::holistic::cross_module_architecture::coupled_id_namespaces_hub::cabfef4c": {
      "id": "review::.::holistic::cross_module_architecture::coupled_id_namespaces_hub::cabfef4c",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Tool identity and settings identity are co-located in one shared hub, coupling unrelated modules through a single contract.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/toolIds.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [
          "`SETTINGS_IDS` is defined as `{ ...TOOL_IDS, ... }`, so tool IDs are treated as settings IDs in the same module.",
          "The module also exports both validators (`isToolId`, `isKnownSettingsId`), encouraging broad import usage for distinct concerns.",
          "This creates cross-module dependency pressure on a single file for both routing/tool semantics and settings persistence semantics."
        ],
        "suggestion": "Split into separate bounded modules (`toolIds.ts` and `settingsIds.ts`) with an explicit mapping layer only where overlap is intended; migrate call sites to import only the boundary they need.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Split settings identity from tool identity by introducing src/shared/lib/settingsIds.ts, moving SETTINGS_IDS/isKnownSettingsId there, and migrating imports so toolIds.ts now owns only tool IDs.",
      "first_seen": "2026-02-25T17:35:53+00:00",
      "last_seen": "2026-02-25T17:35:53+00:00",
      "resolved_at": "2026-02-25T18:16:37+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually separated tool and settings ID namespaces into distinct modules with migrated imports, and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T18:16:37+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::cross_module_architecture::global_toast_runtime_singleton::de3d5295": {
      "id": "review::.::holistic::cross_module_architecture::global_toast_runtime_singleton::de3d5295",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Notification handling relies on a global runtime singleton, creating hidden cross-module coupling.",

    "review::.::holistic::error_consistency::ignored_subtask_query_error_fallback::f4031d20": {
      "id": "review::.::holistic::error_consistency::ignored_subtask_query_error_fallback::f4031d20",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Sub-task query errors are ignored and downgraded into normal-flow billing calculations.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/calculate-task-cost/index.ts",
          "supabase/functions/complete_task/orchestrator.ts"
        ],
        "evidence": [
          "`calculate-task-cost` assigns `error` to `_subTasksError` and never branches on it (`supabase/functions/calculate-task-cost/index.ts:291-301`).",
          "When `subTasks` is empty (including error cases), code falls back to task-level duration (`supabase/functions/calculate-task-cost/index.ts:322-327`) instead of returning a recoverable billing error.",
          "Upstream orchestrator completion relies on billing call outcomes (`supabase/functions/complete_task/orchestrator.ts:439-445`), so hidden query errors can propagate as incorrect cost records."
        ],
        "suggestion": "Handle `_subTasksError` explicitly: log structured context, return `errorResponse('subtask_query_failed', ...)` (recoverable), and avoid falling back to regular duration when orchestrator detection query fails.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T20:25:15+00:00",

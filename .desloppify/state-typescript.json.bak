    "review::.::holistic::error_consistency::mixed_error_shape_between_task_and_mutation_layers::0774024d": {
      "id": "review::.::holistic::error_consistency::mixed_error_shape_between_task_and_mutation_layers::0774024d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Neighboring data/task paths use incompatible error shapes (normalized AppError vs ad-hoc Error strings), making failure handling non-uniform.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/hooks/useGenerationMutations.ts",
          "src/shared/hooks/useTasks.ts",
          "src/shared/lib/tasks/imageGeneration.ts",
          "src/shared/lib/tasks/joinClips.ts"
        ],
        "evidence": [
          "`useGenerationMutations` and `useTasks` throw new string-wrapped `Error` instances (e.g., `Failed to update generation...`, `Task with ID ... not found...`), which discard upstream structured metadata.",
          "Task builders (`imageGeneration`, `joinClips`, plus other task modules in this batch) consistently use `throw handleError(error, { context, showToast: false })`, yielding normalized `AppError` payloads.",
          "Callers across these modules cannot reliably depend on one contract (e.g., preserved context/error code/showToast metadata) because thrown types differ by file."
        ],
        "suggestion": "Standardize thrown errors at data/task boundaries: replace ad-hoc `new Error(...)` wrapping with a shared normalizer (e.g., `handleAndRethrow` or dedicated mapper that preserves original cause/code) and only add user-facing copy at presentation layer.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-24T18:44:55+00:00",
      "last_seen": "2026-02-24T18:44:55+00:00",

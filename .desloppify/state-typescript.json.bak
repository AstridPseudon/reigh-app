    "review::.::holistic::api_surface_coherence::edge_gate_result_shape_drift::28640557": {
      "id": "review::.::holistic::api_surface_coherence::edge_gate_result_shape_drift::28640557",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Edge request gates use conflicting denial/result shapes for similar control flow",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "supabase/functions/_shared/edgeRequest.ts",
          "supabase/functions/_shared/rateLimit.ts",
          "supabase/functions/_shared/billing.ts"
        ],
        "evidence": [
          "`ensureRequestMethod` returns `operationFailure(...errorCode:'method_not_allowed')` (`ok:false`) for denied requests.",
          "`checkRateLimit` returns `operationSuccess({ allowed:false, ... })` (`ok:true`) when a request is denied by policy, but also returns `ok:true` in degraded fail-open error scenarios.",
          "Other edge helpers such as billing `triggerCostCalculation` model non-success states as `ok:false` failures, so callers cannot apply one consistent gate-handling pattern across shared utilities."
        ],
        "suggestion": "Standardize gatekeeper contracts: either (A) all deny states return `OperationFailure` with explicit codes (`rate_limit_exceeded`, `method_not_allowed`), or (B) all gatekeepers return a dedicated `GateDecision` type separate from `OperationResult`. Document and enforce one pattern across `_shared` edge helpers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

    "review::.::holistic::type_safety::reposition_transform_unvalidated_read::4c4c9fec": {
      "id": "review::.::holistic::type_safety::reposition_transform_unvalidated_read::4c4c9fec",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Persisted transform payload is trusted without validation and used as numeric math input.",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "src/shared/components/MediaLightbox/hooks/reposition/useImageTransform.ts",
          "src/shared/components/MediaLightbox/hooks/reposition/useCanvasTransform.ts",
          "src/shared/components/MediaLightbox/hooks/reposition/types.ts"
        ],
        "evidence": [
          "useImageTransform.ts reads `activeVariantParams?.transform as ImageTransform | undefined` from Record<string, unknown> and only checks object-ness, not field types/ranges.",
          "useCanvasTransform.ts consumes transform fields in arithmetic and CSS transform composition (`translate`, `scale`, `rotate`) assuming valid numbers/booleans."
        ],
        "suggestion": "Add a strict `parseImageTransform` guard that validates each field (finite numbers + boolean flags + bounds where relevant) and falls back to DEFAULT_TRANSFORM on invalid input before state assignment.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

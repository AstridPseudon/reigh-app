    "review::.::holistic::mid_level_elegance::mixed-error-seam-contracts::55e95542": {
      "id": "review::.::holistic::mid_level_elegance::mixed-error-seam-contracts::55e95542",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Cross-layer seams use incompatible failure contracts, increasing glue code and making orchestration paths harder to reason about.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/lib/generationTaskRepository.ts",
          "src/shared/hooks/useLineageChain.ts",
          "src/shared/components/ImageGenerationForm/hooks/referenceUpload/referenceDomainService.ts",
          "src/tools/travel-between-images/components/ShotEditor/services/generateVideoService.ts"
        ],
        "evidence": [
          "`generationTaskRepository` returns status+payload objects (`ok`, `scope_mismatch`, `query_failed`) instead of `OperationResult`.",
          "`useLineageChain` turns repository status failures into thrown `LineageScopeError`, while also throwing normalized runtime errors for DB misses.",
          "`referenceDomainService` and `generateVideoService` use `OperationResult` envelopes, creating a separate failure-handling style that callers must bridge."
        ],
        "suggestion": "Standardize seam contracts per layer (for example, repositories/services return `OperationResult`, UI hooks map to user-facing errors) and remove mixed throw/status/result conversions across these paths.",

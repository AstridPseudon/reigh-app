    "review::.::holistic::cross_module_architecture::implicit_global_runtime_entrypoints::d1df62a4": {
      "id": "review::.::holistic::cross_module_architecture::implicit_global_runtime_entrypoints::d1df62a4",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "High-level runtime facades hide global lifecycle/state behavior, making initialization order implicit across modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/lib/errorHandling/runtimeError.ts"
        ],
        "evidence": [
          "`getSupabaseClient()` is documented as \"safe before bootstrap (lazy initializes when needed)\", so any importer can trigger runtime initialization without explicit app-lifecycle coordination.",
          "`runtimeError.ts` centralizes reporting/throwing entrypoints and is a major import hub, which similarly funnels side-effectful behavior behind globally reachable helpers.",
          "Both files act as broad cross-module entrypoints where call sites cannot distinguish pure access from stateful runtime actions."
        ],
        "suggestion": "Split pure access from side-effectful initialization/reporting by contract: require explicit bootstrap wiring at app composition roots, then inject initialized collaborators (Supabase client, error reporter) into feature modules instead of exposing globally callable lazy entrypoints.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

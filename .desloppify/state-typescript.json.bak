    "review::.::holistic::error_consistency::invariant_failures_downgraded_to_silent_noops::79b2fc29": {
      "id": "review::.::holistic::error_consistency::invariant_failures_downgraded_to_silent_noops::79b2fc29",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Invariant/contract violations are sometimes logged then converted to `null`/early-return no-ops, making failure modes inconsistent for callers.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/components/MediaLightbox/VideoLightbox.tsx",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [
          "`src/shared/components/MediaLightbox/VideoLightbox.tsx:145-150` logs missing required `media` via `handleError` and returns `null`, suppressing propagation of what appears to be an invalid-call-state.",
          "`src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts:61-77,102-107` logs missing shot/lightbox prerequisites and returns early, while neighboring paths in the same hook rethrow (`:50-55`, `:82-87`).",
          "`src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts:68-72` uses `handleAndRethrow` for create-shot failure, showing a stricter failure contract than sibling silent-return handlers in the same gallery surface."
        ],
        "suggestion": "Define explicit rules for invariant failures vs recoverable user-state misses: either return typed `Result` values from handlers or consistently rethrow after `handleError` for contract violations. Avoid mixed silent-return and throw behavior in related UI flows.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

    "review::.::holistic::design_coherence::submission_pipeline_indirection_chain::b4168d0d": {
      "id": "review::.::holistic::design_coherence::submission_pipeline_indirection_chain::b4168d0d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Form submission logic is split across multiple pass-through hooks, adding indirection without a clear reduction in dependency complexity.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/shared/components/ImageGenerationForm/hooks/useFormSubmission.ts",
          "src/shared/components/ImageGenerationForm/hooks/formSubmission/useSubmissionHandlers.ts",
          "src/shared/components/ImageGenerationForm/hooks/formSubmission/useSubmissionOrchestrator.ts"
        ],
        "evidence": [
          "`useFormSubmission` builds `formStateRef` and task params, then forwards a large argument set to `useSubmissionHandlers`.",
          "`useSubmissionHandlers` mostly forwards the same values into `useSubmissionOrchestrator` and repackages command handlers.",
          "`useSubmissionOrchestrator` then contains both queue orchestration and prompt-generation side effects, so layering does not isolate responsibilities cleanly."
        ],
        "suggestion": "Collapse pass-through layers into one primary hook with explicit submodules only where ownership changes (e.g., task plan builder vs queue executor). Keep a minimal command interface at the top boundary and move value derivation closer to use sites.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-25T13:00:09+00:00",

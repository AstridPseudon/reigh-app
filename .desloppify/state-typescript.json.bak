    "review::.::holistic::type_safety::supabase_rest_fetch_private_patch::f3f40f58": {
      "id": "review::.::holistic::type_safety::supabase_rest_fetch_private_patch::f3f40f58",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Supabase client behavior depends on a double-cast mutation of an internal property.",
      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "src/integrations/supabase/bootstrap/createSupabaseClient.ts",
          "src/integrations/supabase/client.ts",
          "src/integrations/supabase/bootstrap/fetchWithTimeout.ts"
        ],
        "evidence": [
          "createSupabaseClient.ts sets `(client as unknown as { rest: { fetch: typeof dataFetch } }).rest.fetch = dataFetch`.",
          "This bypasses official client typings and ties correctness to an undocumented internal shape; compiler cannot detect drift in Supabase internals."
        ],
        "suggestion": "Wrap request customization behind supported Supabase extension points (or a local typed adapter/factory) and isolate one narrowly-typed boundary for the patch with runtime assertion + version guard if internal mutation remains unavoidable.",
        "reasoning": ""
      },
      "status": "auto_resolved",

    "review::.::holistic::cross_module_architecture::media_types_owned_by_parent_feature::cb6a7424": {
      "id": "review::.::holistic::cross_module_architecture::media_types_owned_by_parent_feature::cb6a7424",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "MediaGalleryItem and gallery services depend on MediaGallery\u2019s internal type module.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/components/MediaGallery/types.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts",
          "src/shared/components/MediaGalleryItem/components/InfoTooltip.tsx",
          "src/shared/components/MediaGallery/services/downloadService.ts",
          "src/shared/components/MediaGalleryItem/types.ts"
        ],
        "evidence": [
          "`useMediaGalleryItemState.ts`, `InfoTooltip.tsx`, `ShotActions.tsx`, and other `MediaGalleryItem` files import from `../../MediaGallery/types`.",
          "`downloadService.ts` imports `GeneratedImageWithMetadata` from `@/shared/components/MediaGallery/types` despite being a service used across gallery interactions.",
          "`MediaGalleryItem/types.ts` re-exports types from `../MediaGallery/types`, further spreading parent-feature ownership outward."
        ],
        "suggestion": "Extract gallery media model types into a neutral module (for example `src/shared/media/contracts` or `src/features/gallery/contracts`) and update both `MediaGallery` and `MediaGalleryItem` to consume that shared contract instead of importing from `MediaGallery/types`.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-02T11:38:16+00:00",
      "last_seen": "2026-03-02T11:38:16+00:00",
      "resolved_at": "2026-03-02T11:53:31+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::cross_module_architecture::project_crud_crosses_ui_and_data_layers::daaaf750": {
      "id": "review::.::holistic::cross_module_architecture::project_crud_crosses_ui_and_data_layers::daaaf750",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Project CRUD hook mixes data access, orchestration, and UI error/toast presentation.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/hooks/useProjectCRUD.ts",
          "src/shared/contexts/useProjectSessionCoordinator.ts",
          "src/shared/contexts/ProjectContext.tsx"
        ],
        "evidence": [
          "`useProjectCRUD.ts` imports `getSupabaseClient` (infra), `projectSetupService` (service orchestration), and UI presentation (`toast`, `normalizeAndPresentError`) in the same hook.",
          "The hook directly emits UI toasts (`toast.error(...)`) and presentation errors while also performing DB CRUD and setup transactions.",
          "`ProjectContext` composes `selection + crud + identity`, so this mixed hook becomes a broad app-level dependency surface."
        ],
        "suggestion": "Split `useProjectCRUD` into: (1) a data/repository layer that returns typed results/errors with no UI side effects, and (2) a UI adapter in `ProjectContext` (or a presenter hook) that maps those results to `toast`/runtime-error presentation.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-02T11:38:16+00:00",
      "last_seen": "2026-03-02T11:38:16+00:00",
      "resolved_at": "2026-03-02T11:53:31+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,

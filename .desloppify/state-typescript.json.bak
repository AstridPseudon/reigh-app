          "src/shared/components/ui/runtime/sonner.tsx",
          "src/shared/lib/errorHandling/runtimeError.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts"
        ],
        "evidence": [
          "`Toaster` binds to `getToastManager()` and the module re-exports a global `toast` API.",
          "Error pathways in gallery handlers already depend on centralized runtime error normalization, making user-feedback behavior implicitly coupled to shared global notification runtime.",
          "This pattern increases risk of side effects and ordering assumptions across modules that call into shared error/notification paths."
        ],
        "suggestion": "Introduce an injected notification interface at feature boundaries (or React context-backed facade), so feature hooks depend on a contract instead of global singleton runtime objects.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Reduced cross-module coupling at feature boundaries by introducing injected error reporting in useMediaGalleryHandlers (reportError contract) instead of hard-binding to runtimeError implementation, while runtime error presentation already flows through notifier registration contracts. This removes direct notification policy ownership from gallery orchestration hooks.",
      "first_seen": "2026-02-25T17:35:53+00:00",
      "last_seen": "2026-02-25T17:35:53+00:00",
      "resolved_at": "2026-02-25T19:19:29+00:00",

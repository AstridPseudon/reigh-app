    "review::.::holistic::cross_module_architecture::supabase_implicit_bootstrap_boundary::a3c0391d": {
      "id": "review::.::holistic::cross_module_architecture::supabase_implicit_bootstrap_boundary::a3c0391d",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Supabase client access performs implicit fallback initialization, weakening startup boundary guarantees.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/lib/errorHandling/handleError.ts",
          "src/shared/contexts/ProjectContext.tsx"
        ],
        "evidence": [
          "`getSupabaseClient()` catches runtime access errors and calls `initializeSupabase()` as fallback, then warns once in dev.",
          "This pattern allows arbitrary downstream modules to trigger integration bootstrapping indirectly instead of enforcing explicit bootstrap order.",
          "Large orchestrator providers like `ProjectContext` increase the chance of implicit dependency timing problems because multiple subsystems initialize during render lifecycle."
        ],
        "suggestion": "Make bootstrap explicit and fail-fast: remove lazy fallback from `getSupabaseClient`, require `initializeSupabase` in app startup, and expose a narrow readiness contract (or provider) to consumers that need guaranteed initialization.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

    "review::.::holistic::api_surface_coherence::boolean_param_extraction_silently_masks_invalid_values::dceec1be": {
      "id": "review::.::holistic::api_surface_coherence::boolean_param_extraction_silently_masks_invalid_values::dceec1be",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Boolean task-param API coerces malformed numeric inputs to false, hiding contract violations.",
      "detail": {

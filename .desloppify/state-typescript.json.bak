    "review::.::holistic::error_consistency::raw_console_error_paths_bypass_normalizer::3f53d05e": {
      "id": "review::.::holistic::error_consistency::raw_console_error_paths_bypass_normalizer::3f53d05e",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Some runtime-critical paths still use raw console logging and generic Error objects instead of normalized reporting primitives.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/contexts/ProjectContext.tsx",
          "supabase/functions/complete_task/orchestrator.ts",
          "src/shared/lib/errorHandling/runtimeError.ts"
        ],
        "evidence": [
          "`useProject` logs `console.error(...)` and throws `new Error(...)` directly when provider wiring is invalid, bypassing shared error normalization/reporting interfaces.",
          "`complete_task/orchestrator.ts` uses direct `console.error`/`console.warn` for notable error-adjacent states (billing metadata persistence fallback and terminal-transition warnings), while neighboring code uses `CompletionError`/`toCompletionError` structured paths."
        ],
        "suggestion": "Create and enforce a per-layer boundary helper (`reportRuntimeError` for client runtime, structured logger/error wrapper for edge functions) so exceptional and warning states follow one reporting shape with consistent metadata fields.",
        "reasoning": ""
      },

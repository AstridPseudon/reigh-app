      "tier": 3,
      "confidence": "high",
      "summary": "The UI package is overloaded with mixed concerns, weakening navigability and ownership boundaries.",
      "detail": {
        "holistic": true,
        "dimension": "package_organization",
        "related_files": [
          "src/shared/components/ui/button.tsx",
          "src/shared/components/ui/cn.ts"

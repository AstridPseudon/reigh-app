    "review::.::holistic::cross_module_architecture::error_hub_cross_layer_coupling::a1c72ee2": {
      "id": "review::.::holistic::cross_module_architecture::error_hub_cross_layer_coupling::a1c72ee2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Central error facade combines core error normalization with UI toast side effects.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts",
          "src/integrations/supabase/client.ts"
        ],
        "evidence": [
          "`handleError.ts` exports both pure reporting (`reportError`, `reportAndRethrow`) and UI behavior (`handleError` -> `notifyError`) from one widely imported module.",
          "`useMediaGalleryHandlers.ts` and `useMediaGalleryItemState.ts` import from this hub directly, so feature hooks couple to the shared central module rather than a narrower boundary.",
          "`supabase/client.ts` avoids `handleError` and uses `normalizeAndLogError` directly, showing both patterns coexist and boundary expectations are inconsistent."
        ],
        "suggestion": "Split the error API by layer: keep a pure core module for normalize/log/rethrow and move toast-enabled helpers to an explicit UI/runtime adapter module. Update callers so non-UI layers cannot import toast behavior by default.",
        "reasoning": ""
      },

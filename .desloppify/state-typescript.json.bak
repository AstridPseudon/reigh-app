    "review::.::holistic::cross_module_architecture::supabase_bootstrap_order_coupling::7eaf5454": {
      "id": "review::.::holistic::cross_module_architecture::supabase_bootstrap_order_coupling::7eaf5454",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Supabase client access depends on implicit global initialization order, creating fragile cross-module coupling.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/lib/errorHandling/runtimeError.ts"
        ],
        "evidence": [
          "`getSupabaseClient()` has a comment-only precondition that `initializeSupabase()` must already have run (`src/integrations/supabase/client.ts:17-19`), but the API surface does not encode or enforce this.",
          "This module is a high-import runtime gateway per the packet, so any call-site that runs before bootstrap can fail in a broad blast radius.",
          "The same global-runtime access pattern appears in other shared gateways (`runtimeError.ts` re-export + side-effect helper), reinforcing a cross-module singleton pattern instead of explicit dependency flow."
        ],
        "suggestion": "Replace ambient singleton access with an explicit provider/factory boundary: initialize once at app root, pass client through context or injected service interfaces, and make pre-initialization calls unrepresentable at type level.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Supabase facade now routes getSupabaseClient through lazy-safe runtime initializer, removing bootstrap-order fragility from callers.",
      "first_seen": "2026-02-25T16:06:56+00:00",
      "last_seen": "2026-02-25T16:06:56+00:00",
      "resolved_at": "2026-02-25T16:20:36+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually made Supabase client access lazy-safe through runtime initialization, and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T16:20:36+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::cross_module_architecture::hub_facade_boundary_dilution::b514fb23": {
      "id": "review::.::holistic::cross_module_architecture::hub_facade_boundary_dilution::b514fb23",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "High-import facade files act as traffic hubs without meaningful boundary contracts, diluting module ownership.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/runtimeError.ts",
          "src/domains/generation/types/public.ts",
          "src/shared/components/ui/tooltip.tsx",
          "src/shared/hooks/mobile/index.ts"
        ],
        "evidence": [
          "`runtimeError.ts` and `types/public.ts` are mostly re-export surfaces with minimal local semantics, yet are heavily imported according to the packet.",
          "`tooltip.tsx` and `hooks/mobile/index.ts` similarly aggregate exports, which centralizes import paths but does not enforce layering or prevent dependency creep.",
          "When these facades become the dominant import entry points, internal reorganizations or API drifts tend to ripple widely because the hub has many dependents but little contract strictness."
        ],
        "suggestion": "Keep only stable, intentional facades and split generic pass-through hubs by bounded context (e.g., domain API vs UI runtime API). Add explicit layering rules for what each facade may export.",
        "reasoning": ""
      },

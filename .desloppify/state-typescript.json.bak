    "review::.::holistic::design_coherence::clip_manager_stale_async_writes::952b1a43": {
      "id": "review::.::holistic::design_coherence::clip_manager_stale_async_writes::952b1a43",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Join clips hydration effects can apply stale async results after project switches",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/join-clips/hooks/useClipManager.ts",
          "src/tools/join-clips/lib/clipInitService.ts",
          "src/tools/join-clips/pages/JoinClipsPage.tsx"
        ],
        "evidence": [
          "`useClipManager.ts` resets state on project change (`setClips([])`, `setInitialHydrationComplete(false)`), but async calls from earlier project context still resolve and call `setClips`/`setInitialHydrationComplete` (pending clip consume and poster preload paths).",
          "The async branches in `consumePendingJoinClips(...).then(...)` and `preloadPosterImages(...).then(...)` do not validate current project/version before mutating state.",
          "This mixes initialization, persistence, and async queue processing in one hook without lifecycle guards, making ordering bugs likely under rapid project switches."
        ],
        "suggestion": "Add a per-project request version/cancellation guard (e.g., incrementing ref token or `AbortController`) and discard stale async completions when project/context changes; isolate hydration pipeline into a dedicated hook/service that returns guarded state transitions.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Added per-project async request-version guards for hydration and pending-clips consumption in useClipManager, plus regressions that verify stale completions are ignored after project switches.",
      "first_seen": "2026-03-02T12:39:56+00:00",
      "last_seen": "2026-03-02T12:39:56+00:00",

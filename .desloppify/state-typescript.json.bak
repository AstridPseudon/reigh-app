    "review::.::holistic::error_consistency::mixed_error_channels_console_vs_pipeline::4f6b4942": {
      "id": "review::.::holistic::error_consistency::mixed_error_channels_console_vs_pipeline::4f6b4942",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Operational failures are reported through mixed channels (`handleError` vs direct `console.error`), producing inconsistent diagnostics and alerting behavior.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/lib/tasks/imageGeneration.ts",
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/calculate-task-cost/index.ts",
          "src/shared/lib/errorHandling/handleError.ts"
        ],
        "evidence": [
          "`src/shared/lib/errorHandling/handleError.ts:45-60` defines a normalized error path, but `src/shared/lib/tasks/imageGeneration.ts:519,528` logs rejected task failures directly via `console.error`.",
          "`supabase/functions/complete_task/orchestrator.ts:422` logs failed cost calculation with `console.error` rather than using the structured logger/error pipeline used elsewhere.",
          "`supabase/functions/calculate-task-cost/index.ts:177` uses direct `console.error` for missing environment configuration, while later branches use structured logger/errorResponse handling."
        ],
        "suggestion": "Adopt one required error-reporting contract per runtime: in browser code, route failures through `handleError` (or a thin wrapper); in edge functions, use `SystemLogger`/structured error responses consistently and ban raw `console.error` except bootstrap fallback code.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T19:50:39+00:00",

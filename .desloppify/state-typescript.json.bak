    "review::.::holistic::cross_module_architecture::media_gallery_distributed_state_machine::b200479a": {
      "id": "review::.::holistic::cross_module_architecture::media_gallery_distributed_state_machine::b200479a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Media gallery flow is implemented as a distributed state machine across hooks/components.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGallery/hooks/useMobileInteractions.ts",
          "src/shared/components/MediaGalleryItem/components/ShotActions.tsx",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [
          "`useMediaGalleryHandlers` accepts a broad orchestration contract (shot arrays, navigation, filter mutators, modal setters, lightbox setter, optional associated-shot flow) and performs both command handling and effectful context reconciliation.",
          "`useMobileInteractions` requires caller-owned mutable refs (`lastTouchTimeRef`, `lastTappedImageIdRef`, `doubleTapTimeoutRef`) to coordinate tap semantics, indicating shared state ownership across module boundaries.",
          "`ShotActions` consumes four grouped prop objects (`selector`, `status`, `quickCreate`, `actions`) and still performs control-flow decisions (navigate vs add) using cross-cutting flags, showing state/decision logic split across layers."
        ],
        "suggestion": "Introduce a feature-level gallery interaction controller (single hook/service) that owns tap/selection/add-to-shot workflow state and exposes a narrow command/query API to UI components; move mutable refs and transition logic inside that controller, and make presentational components receive only derived view models plus intent callbacks.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-25T13:23:58+00:00",

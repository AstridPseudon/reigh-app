    "review::.::holistic::api_surface_coherence::rate_limit_success_error_duality::cc0f03a3": {
      "id": "review::.::holistic::api_surface_coherence::rate_limit_success_error_duality::cc0f03a3",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Rate-limit denial is encoded as a successful operation result, diverging from neighboring edge APIs that use failure envelopes for request rejection.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "supabase/functions/_shared/rateLimit.ts",
          "supabase/functions/_shared/edgeRequest.ts"
        ],
        "evidence": [
          "`checkRateLimit` returns `operationSuccess({ allowed: false, ... })` for exceeded limits (`rateLimit.ts:172-181`), while method violations in `ensureRequestMethod` return `operationFailure` (`edgeRequest.ts:61-67`).",
          "Callers need special branching helpers (`isRateLimitExceededFailure`) to interpret an effective error state carried on an ok result (`rateLimit.ts:275-280`)."
        ],
        "suggestion": "Normalize edge guard semantics so denied limits are represented as `operationFailure` with a stable `rate_limit_exceeded` code and structured decision data in `cause`; keep `allowed:false` only as response payload shaping, not as the primary control-flow contract.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T17:00:52+00:00",

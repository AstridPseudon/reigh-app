    "review::.::holistic::api_surface_coherence::scope_status_contract_unreachable::4a747665": {
      "id": "review::.::holistic::api_surface_coherence::scope_status_contract_unreachable::4a747665",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Generation/variant scope APIs advertise missing-entity statuses that their query path cannot reliably produce.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/shared/lib/generationTaskRepository.ts",
          "src/shared/hooks/useLineageChain.ts",
          "src/shared/lib/generationTaskCache.ts"
        ],
        "evidence": [
          "`resolveGenerationProjectScope` queries with `.single()` then immediately returns `query_failed` on any error (`src/shared/lib/generationTaskRepository.ts:62-75`), so `missing_generation` at `:77-83` is effectively bypassed for no-row cases.",
          "`resolveVariantProjectScope` has the same pattern (`:113-127`), undermining `missing_variant` at `:129-136`.",
          "Downstream code branches on these statuses for user-facing behavior (`src/shared/hooks/useLineageChain.ts:78-92`), so status drift changes API meaning outside the repository layer."
        ],
        "suggestion": "Make repository scope lookups use `maybeSingle()` (or explicit no-row error-code handling) so `missing_generation`/`missing_variant` are emitted deterministically, and align downstream consumers/tests to the corrected status contract.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Generation/variant scope lookups now use maybeSingle() plus explicit no-row handling to emit missing_generation/missing_variant statuses; tests updated.",
      "first_seen": "2026-02-25T16:06:56+00:00",
      "last_seen": "2026-02-25T16:06:56+00:00",
      "resolved_at": "2026-02-25T16:20:35+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually changed the scope repository query path to maybeSingle with no-row handling and added tests, and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T16:20:35+00:00",
        "scan_verified": false
      }
    },

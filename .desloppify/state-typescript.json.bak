      "tier": 3,
      "confidence": "high",
      "summary": "Deprecated supabase proxy keeps runtime initialization order implicit in data hooks.",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/hooks/useTasks.ts"
        ],
        "evidence": [
          "`client.ts` catches runtime-access errors and lazily falls back to initialization inside `getSupabaseClient`, while exporting `supabase` as a compatibility Proxy.",

    "review::.::holistic::error_consistency::task_pane_mixed_failure_contracts::3e7828e2": {
      "id": "review::.::holistic::error_consistency::task_pane_mixed_failure_contracts::3e7828e2",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Adjacent task-pane hooks use incompatible error contracts (throwing vs degraded result objects), creating inconsistent failure behavior.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/shared/hooks/useTasks.ts",
          "src/shared/hooks/useTaskStatusCounts.ts"
        ],
        "evidence": [
          "`useTasks` query functions call `normalizeAndPresentAndRethrow(...)`, causing React Query error states on fetch failures.",
          "`useTaskStatusCounts` intentionally catches/normalizes per-query failures and returns a successful query payload with `degraded: true` and embedded `operationFailure`, avoiding thrown query errors."
        ],
        "suggestion": "Define one shared contract for task-pane data hooks (either throw-on-failure with explicit partial-query aggregation wrapper, or always return typed degraded results) and apply it consistently so UI consumers do not need per-hook error semantics.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T16:06:56+00:00",
      "last_seen": "2026-02-25T16:06:56+00:00",
      "resolved_at": "2026-02-25T16:38:47+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null

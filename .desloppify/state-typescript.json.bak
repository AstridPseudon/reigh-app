    "review::.::holistic::cross_module_architecture::gallery_interaction_state_spans_multiple_modules::d534d8fe": {
      "id": "review::.::holistic::cross_module_architecture::gallery_interaction_state_spans_multiple_modules::d534d8fe",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Media gallery interaction state is scattered across hooks/components with cross-module mutable choreography.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts",
          "src/shared/components/MediaGalleryItem/components/InfoTooltip.tsx",
          "src/shared/components/MediaGalleryItem/components/ShotActions.tsx",
          "src/shared/components/MediaGallery/hooks/useMobileInteractions.ts",
          "src/shared/contexts/ProjectContext.tsx"
        ],
        "evidence": [
          "`useMediaGalleryItemState.ts` exposes many mutable setters (`setIsInfoOpen`, `setIsShotSelectorOpen`, `setIsCreateShotModalOpen`, etc.) for other modules to coordinate.",
          "`InfoTooltip.tsx` and `ShotActions.tsx` each depend on externally managed open/selection state callbacks, creating distributed UI-state ownership.",
          "`useMobileInteractions.ts` introduces additional mutable refs/timeouts and global event listeners for related interaction behavior.",
          "`ProjectContext.tsx` also uses a global window bridge (`window.__PROJECT_CONTEXT__`) for fallback coordination, reinforcing subsystem-level shared mutable state patterns."
        ],
        "suggestion": "Introduce a single gallery interaction controller (reducer/state machine) that owns tooltip/selector/popover/lightbox transitions and exposes declarative events. Remove ad-hoc setter/ref passing and eliminate global fallback channels for interaction/state handoff.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T03:47:02+00:00",
      "last_seen": "2026-02-25T03:47:02+00:00",

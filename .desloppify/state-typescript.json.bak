    "review::.::holistic::cross_module_architecture::shared_type_and_route_hubs_inflate_blast_radius::a449049c": {
      "id": "review::.::holistic::cross_module_architecture::shared_type_and_route_hubs_inflate_blast_radius::a449049c",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Global barrels/constants centralize unrelated concerns and increase cross-module coupling.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/types/generationAndShots.ts",
          "src/shared/lib/toolConstants.ts",
          "src/pages/Home/components/panes/CreativePartnerPane.tsx",
          "src/shared/components/MediaLightbox/components/LightboxShell.tsx"
        ],
        "evidence": [
          "`generationAndShots.ts` aggregates multiple type sources into a canonical barrel, encouraging broad imports from many features instead of narrower domain contracts.",
          "`toolConstants.ts` mixes tool IDs, routes, and URL construction in one shared file used by page and shared components.",
          "`CreativePartnerPane.tsx` imports `TOOL_ROUTES` directly, creating dependency from page UI to global shared routing constants instead of a feature-local navigation contract."
        ],
        "suggestion": "Split shared hubs by bounded context: domain type entrypoints per feature area and tool-specific route modules; expose small, purpose-scoped contracts (e.g., `homeNavigationContract`, `galleryTaskContracts`) instead of one global barrel for each concern.",
        "reasoning": ""
      },
      "status": "auto_resolved",

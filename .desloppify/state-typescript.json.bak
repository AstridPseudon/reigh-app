    "review::.::holistic::cross_module_architecture::legacy_supabase_parallel_surface_still_primary::3e7b5692": {
      "id": "review::.::holistic::cross_module_architecture::legacy_supabase_parallel_surface_still_primary::3e7b5692",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Legacy Supabase facade remains a parallel primary client surface across modules.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "README.md",
          "src/integrations/supabase/legacy/legacySupabaseFacade.ts"
        ],
        "evidence": [
          "README.md sets a temporary-compatibility policy with budget `--max 129` and sunset date `2026-06-30`.",
          "legacySupabaseFacade.ts still exports `supabase` object wrapper and `getLegacySupabaseClient()`, keeping legacy and canonical access paths alive in parallel.",
          "Current source import count for the legacy facade is 134, indicating the compatibility path is still a dominant dependency hub."
        ],
        "suggestion": "Collapse usage to one migration boundary: forbid new `supabase` facade imports in CI, migrate call sites to `getSupabaseClient()`, and reduce the facade to a narrowly-scoped adapter (or internal module) with a shrinking allowlist tied to milestone dates.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T22:54:40+00:00",

    "review::.::holistic::cross_module_architecture::error_api_boundary_fragmentation::e1dd22cc": {
      "id": "review::.::holistic::cross_module_architecture::error_api_boundary_fragmentation::e1dd22cc",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Error handling is split across parallel facades, creating boundary drift and hub coupling.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [

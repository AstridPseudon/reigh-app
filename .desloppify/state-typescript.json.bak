    "review::.::holistic::error_consistency::shot_editor_callback_failure_contract_mix::f8d0fb6c": {
      "id": "review::.::holistic::error_consistency::shot_editor_callback_failure_contract_mix::f8d0fb6c",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Shot image editor callbacks mix throw-based and sentinel-based failure contracts for similar adapter operations.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/tools/travel-between-images/components/ShotImagesEditor/hooks/useShotImagesEditorCallbacks.ts",
          "src/shared/hooks/useGenerationMutations.ts"
        ],
        "evidence": [
          "Callback adapters in `useShotImagesEditorCallbacks` return `false`/`undefined` when handlers are absent (`lines 164-166`, `179-180`, `193-195`) but throw on runtime errors via `handleAndRethrow` (`lines 170-175`, `184-189`, `199-204`).",
          "In the same hook, delete fallback in non-preloaded mode throws immediately (`lines 229-231`), creating a third behavior for capability-missing cases.",
          "Related mutation hooks generally use throw/`handleAndRethrow` for DB operation failures (`src/shared/hooks/useGenerationMutations.ts`), so consumers can\u2019t rely on a single callback error contract across adjacent flows."
        ],
        "suggestion": "Define one explicit callback contract (prefer `Promise<Result>` or consistent throw semantics) for add/create/delete adapters, and normalize missing-capability cases to the same contract rather than mixing sentinels and thrown errors.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T20:25:15+00:00",
      "last_seen": "2026-02-24T20:25:15+00:00",
      "resolved_at": "2026-02-24T20:29:05+00:00",
      "reopen_count": 0,
      "lang": "typescript",

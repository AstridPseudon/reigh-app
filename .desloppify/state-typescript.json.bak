    "review::.::holistic::cross_module_architecture::global_runtime_state_and_boot_order_coupling::c203c7f7": {
      "id": "review::.::holistic::cross_module_architecture::global_runtime_state_and_boot_order_coupling::c203c7f7",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Global mutable error/reporting and lazy runtime recovery create hidden startup-order dependencies.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "src/integrations/supabase/client.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [
          "`handleError.ts` exposes `setErrorPresenter` which globally rewires notifier behavior via `configureErrorNotifier`.",
          "`getSupabaseClient()` catches runtime access failures and mutates module-level warning state (`hasWarnedFallbackInitialization`) before retrying initialization.",
          "Feature-level hooks such as `useMediaGalleryItemState.ts` call shared `handleError`, tying domain UI flow to a global runtime error singleton."
        ],
        "suggestion": "Move error presentation and runtime client access behind explicit app-level providers/context and make hooks consume injected dependencies instead of global mutable module state.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T17:50:09+00:00",
      "last_seen": "2026-02-24T17:50:09+00:00",
      "resolved_at": "2026-02-24T17:50:09+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::high_level_elegance::implicit_cross_hook_contracts_in_gallery_preload::c426385c": {
      "id": "review::.::holistic::high_level_elegance::implicit_cross_hook_contracts_in_gallery_preload::c426385c",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Gallery preloading depends on implicit contracts instead of stable domain-owned interfaces.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "src/features/gallery/hooks/useAdjacentPagePreloader.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaTypeFilter.tsx"
        ],
        "evidence": [
          "`useAdjacentPagePreloader.ts` derives `GenerationFilters` from `Parameters<typeof fetchGenerations>[3]`, so a positional signature change silently breaks preloader typing/contracts.",
          "The same hook passes both raw `filters` and serialized `filtersString`, indicating coordination logic distributed across call boundaries instead of one canonical query-key/filter contract.",
          "`useMediaGalleryHandlers.ts` and `MediaTypeFilter.tsx` operate on filter state through literal values and callbacks, but no explicit shared filter domain contract is owned at one boundary."
        ],
        "suggestion": "Define a dedicated gallery filter/preload contract module (explicit `GenerationFilters` type + key builder + normalizer) and have preloader, handlers, and UI components depend on that stable interface.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T17:50:09+00:00",
      "last_seen": "2026-02-24T17:50:09+00:00",
      "resolved_at": "2026-02-24T17:50:09+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::high_level_elegance::media_gallery_item_flow_has_split_ownership::2ecc3b6a": {

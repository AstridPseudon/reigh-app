    "review::.::holistic::cross_module_architecture::domain_shared_bidirectional_dependency::4ad43674": {
      "id": "review::.::holistic::cross_module_architecture::domain_shared_bidirectional_dependency::4ad43674",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Generation domain and shared layer are mutually dependent with no stable boundary direction",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/domains/generation/hooks/useDeleteGenerationAction.ts",
          "src/shared/contexts/ProjectContext.tsx",
          "src/shared/components/MediaGallery/index.tsx",
          "src/domains/generation/hooks/useGenerationMutations.ts"
        ],
        "evidence": [
          "`useDeleteGenerationAction` (domain) imports `useProjectSelectionContext` from shared context, binding domain actions to app/session context shape.",
          "`MediaGallery/index.tsx` (shared UI) imports domain mutation hook `useToggleGenerationStar`, so shared also depends upward on domain behavior.",
          "This two-way dependency pattern repeats with domain hooks using shared runtime/query/error modules and shared modules importing domain types/hooks, preventing enforceable module layering."
        ],
        "suggestion": "Introduce a one-way dependency rule: move cross-cutting generation contracts (IDs, row types, scope inputs) into a neutral `entities/generation` package, keep domain hooks depending only on domain/integration abstractions, and have shared UI call app-level adapters instead of domain hooks directly.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Removed shared-to-domain star mutation import from MediaGallery and pushed star/delete project scope wiring to feature/tool adapters, reducing direct bidirectional coupling.",
      "first_seen": "2026-03-02T14:44:49+00:00",
      "last_seen": "2026-03-02T14:44:49+00:00",
      "resolved_at": "2026-03-02T17:19:05+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Removed shared-to-domain star mutation import from MediaGallery and pushed star/delete project scope wiring to feature/tool adapters, reducing direct bidirectional coupling. and I am not gaming the score.",
        "attested_at": "2026-03-02T17:19:05+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::cross_module_architecture::supabase_singleton_boot_order_coupling::aee39f24": {
      "id": "review::.::holistic::cross_module_architecture::supabase_singleton_boot_order_coupling::aee39f24",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Global Supabase singleton leaks infrastructure dependency across feature and shared modules",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/app/bootstrap.tsx",
          "src/shared/services/projects/projectSetupService.ts",
          "src/pages/Home/hooks/useHomeAuth.ts"
        ],
        "evidence": [
          "`src/integrations/supabase/client.ts` uses process-wide mutable state (`hasInitializedRuntimeClient`) and throws when accessed before bootstrap.",
          "`src/app/bootstrap.tsx` performs mandatory global initialization (`initializeSupabase()`), creating hidden order dependence between bootstrap and consumers.",
          "Many modules outside integration layer import `getSupabaseClient` directly, spreading infra concerns through pages, hooks, and shared services rather than containing them behind repositories."
        ],
        "suggestion": "Constrain `getSupabaseClient` usage to integration/repository modules and expose feature-facing repositories/services via dependency injection (context/provider or explicit factory) so runtime boot order is localized and testable.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Moved home-auth and project-setup Supabase calls behind integration repository modules, removing direct getSupabaseClient usage from feature/shared modules and localizing boot-order dependency seams.",
      "first_seen": "2026-03-02T14:44:49+00:00",
      "last_seen": "2026-03-02T14:44:49+00:00",
      "resolved_at": "2026-03-02T17:23:27+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually Moved home-auth and project-setup Supabase calls behind integration repository modules, removing direct getSupabaseClient usage from feature/shared modules and localizing boot-order dependency seams. and I am not gaming the score.",
        "attested_at": "2026-03-02T17:23:27+00:00",
        "scan_verified": false
      }
    },
    "review::.::holistic::high_level_elegance::lightbox_contract_overaggregation::d29c3c7b": {
      "id": "review::.::holistic::high_level_elegance::lightbox_contract_overaggregation::d29c3c7b",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Lightbox subsystem relies on oversized contract aggregation and pass-through orchestration",
      "detail": {
        "holistic": true,

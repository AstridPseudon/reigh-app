    "review::.::holistic::design_coherence::state_bag_contracts_across_timeline_ui::cc6203aa": {
      "id": "review::.::holistic::design_coherence::state_bag_contracts_across_timeline_ui::cc6203aa",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Travel/timeline UI relies on oversized prop/state contracts that mix domain logic, UI controls, and persistence triggers in single units.",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/tools/travel-between-images/components/BatchSettingsForm.tsx",
          "src/tools/travel-between-images/components/MotionControl.tsx",
          "src/tools/travel-between-images/components/Timeline/TimelineItem.tsx",
          "src/tools/travel-between-images/components/Timeline/hooks/useTimelineOrchestrator.ts"
        ],
        "evidence": [
          "`BatchSettingsFormProps` carries many unrelated concerns (prompt editing, phase config, mode toggles, seed/turbo controls, preset callbacks, text-before/after, read-only behavior) in one interface.",
          "`TimelineItemProps` includes drag mechanics, selection state, duplication/delete actions, prefetch, touch behavior, and layout parameters together.",
          "`useTimelineOrchestrator` accepts and returns broad multi-domain structures (`viewport`, `drag`, `selection`, `pending`, `drop`, `actions`, `endpoint`, `uiState`, `device`), creating a high-coupling seam."
        ],
        "suggestion": "Split these contracts into focused capability modules: timeline interaction state, shot mutation actions, and presentation-only props. Introduce a typed coordinator object per concern (interaction, mutation, rendering) and compose in parent containers instead of passing a single mega-contract.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-25T13:00:09+00:00",
      "last_seen": "2026-02-25T13:00:09+00:00",
      "resolved_at": "2026-02-25T14:05:53+00:00",

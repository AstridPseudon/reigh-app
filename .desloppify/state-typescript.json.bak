    "review::.::holistic::api_surface_coherence::tool-id-stringly-api::1caf9a93": {
      "id": "review::.::holistic::api_surface_coherence::tool-id-stringly-api::1caf9a93",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Canonical tool IDs exist, but boundary APIs still accept plain strings, allowing silent identifier drift.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/shared/lib/toolIds.ts",
          "src/shared/lib/toolSettingsService.ts",
          "src/shared/lib/generationTransformers.ts"
        ],
        "evidence": [
          "`TOOL_IDS` is declared as the shared source of truth for tool keys in `toolIds.ts`.",
          "`fetchToolSettingsSupabase` accepts `toolId: string` and indexes settings/default registries with arbitrary strings.",
          "Other paths compare raw payload values against constants (e.g. `item.params?.tool_type === TOOL_IDS.TRAVEL_BETWEEN_IMAGES`) instead of sharing a typed `ToolId` contract."
        ],
        "suggestion": "Export `ToolId = typeof TOOL_IDS[keyof typeof TOOL_IDS]` (and optionally `ToolIdKey`) and require it at API boundaries (`fetchToolSettingsSupabase`, transformer helpers, request builders) so invalid tool IDs are compile-time failures.",
        "reasoning": ""
      },
      "status": "fixed",

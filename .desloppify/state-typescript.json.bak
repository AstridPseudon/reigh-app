    "review::.::holistic::api_surface_coherence::async_delete_handler_dropped::ac678754": {
      "id": "review::.::holistic::api_surface_coherence::async_delete_handler_dropped::ac678754",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Async delete handlers passed into lightbox are invoked as sync fire-and-forget with no failure channel.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/shared/components/MediaGallery/components/MediaGalleryLightbox.tsx",
          "src/shared/components/MediaLightbox/MediaLightbox.tsx",
          "src/shared/components/MediaLightbox/ImageLightbox.tsx"
        ],
        "evidence": [
          "Media gallery side provides delete callback as async (`onDelete?: (id) => Promise<void>`) (`MediaGalleryLightbox.tsx:33`).",
          "Core lightbox prop types erase async intent (`onDelete?: (id) => void`) (`MediaLightbox.tsx:31`).",
          "Image lightbox executes delete without await/error handling (`actions?.onDelete?.(media.id)`) (`ImageLightbox.tsx:687-689`), so promise rejections cannot be surfaced through this boundary."
        ],
        "suggestion": "Standardize `onDelete` as async in canonical lightbox props and await it where invoked (with explicit loading/error handling), or strictly enforce sync behavior at all call sites and remove async typed variants.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Standardized lightbox onDelete to a shared async-capable contract (void|Promise) and replaced fire-and-forget invocation with awaited Promise.resolve(...) flows plus explicit delete error handling in Image/Video/shared lightbox paths.",

    },
    "review::.::holistic::cross_module_architecture::duplicate_open_state_contracts::49148f7a": {
      "id": "review::.::holistic::cross_module_architecture::duplicate_open_state_contracts::49148f7a",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Open-state dialog contract is duplicated between shared UI and generation domain.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/components/dialogs/contracts.ts",
          "src/domains/generation/contracts/deleteGenerationConfirm.ts",
          "src/domains/generation/hooks/useDeleteGenerationWithConfirm.ts",
          "src/pages/Home/components/install/InstallInstructionsModal.tsx"
        ],
        "evidence": [
          "`OpenStateContract` already defines `{ open, onOpenChange }` in shared dialogs contracts.",
          "`DeleteGenerationConfirmContract` redefines the same `open`/`onOpenChange` shape in the generation domain.",
          "Other modules (for example `InstallInstructionsModal`) already consume the shared open-state contract, so this is inconsistent boundary typing."
        ],
        "suggestion": "Standardize on `OpenStateContract` as the base dialog contract and compose domain-specific fields on top of it (for example `type DeleteGenerationConfirmContract = OpenStateContract & { onConfirm: () => void }`).",
        "reasoning": ""
      },
      "status": "auto_resolved",

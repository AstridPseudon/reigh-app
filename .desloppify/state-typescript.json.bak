      "summary": "A combined generation+shot type barrel increases cross-domain coupling for consumers that only need one side.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/types/generationAndShots.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts"

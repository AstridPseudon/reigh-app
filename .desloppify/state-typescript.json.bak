    "review::.::holistic::high_level_elegance::toast_boot_order_coupling::af71f427": {
      "id": "review::.::holistic::high_level_elegance::toast_boot_order_coupling::af71f427",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Toast runtime depends on hidden initialization order between global API and UI mount",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "src/shared/components/ui/runtime/sonner.tsx",
          "src/shared/components/ui/toast.tsx"
        ],
        "evidence": [
          "`Toaster` calls `initializeUiToastManager()` during component render lifecycle, not at explicit app bootstrap.",
          "`toast` methods call `getToastManager().add(...)` and swallow failures with `console.warn('[toast] runtime not initialized; dropping toast', ...)`.",
          "This means callers can import/use `toast` before provider initialization and silently lose notifications."
        ],
        "suggestion": "Move toast runtime initialization to an explicit bootstrap contract (or lazy-safe singleton accessor that cannot drop events), and make failure explicit in development. Keep `toast` API and provider wiring in the same ownership boundary with deterministic init semantics.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Moved toast runtime initialization to bootstrap via initializeUiToastManager and removed silent drop behavior in toast API path.",
      "first_seen": "2026-02-25T19:52:30+00:00",
      "last_seen": "2026-02-25T19:52:30+00:00",
      "resolved_at": "2026-02-25T20:14:34+00:00",

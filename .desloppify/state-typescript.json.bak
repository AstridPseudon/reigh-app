    "review::.::holistic::error_consistency::completion_billing_failure_policy_gap::8d95c8a5": {
      "id": "review::.::holistic::error_consistency::completion_billing_failure_policy_gap::8d95c8a5",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Orchestrator completion mixes fatal and log-only failure handling for billing in one control path.",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/calculate-task-cost/index.ts"
        ],
        "evidence": [
          "`markOrchestratorComplete` throws on orchestrator task update failure (`updateOrchError`), but does not throw when `triggerCostCalculation` returns `ok: false`.",
          "When persisting `billing_outcome` fails (`billingPersistError`), code only logs and continues, despite this metadata being the reconciliation artifact for non-success billing outcomes.",
          "`calculate-task-cost` emits structured error codes/recoverability, but no shared policy maps those to required orchestrator state transitions or retry scheduling."
        ],
        "suggestion": "Introduce a shared billing completion policy helper used by orchestrator completion: map billing result classes (`recorded`, `skipped`, `recoverable_failure`, `nonrecoverable_failure`, `persistence_failure`) to explicit actions (complete-with-retry-flag, fail-task, or enqueue compensating retry), and enforce that policy before returning.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",
      "first_seen": "2026-02-24T20:57:52+00:00",
      "last_seen": "2026-02-24T20:57:52+00:00",
      "resolved_at": "2026-02-25T14:05:53+00:00",
      "reopen_count": 0,

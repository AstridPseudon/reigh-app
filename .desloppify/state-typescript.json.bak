    "review::.::holistic::abstraction_fitness::task_param_bag_mixed_modes_persist::971cdb92": {
      "id": "review::.::holistic::abstraction_fitness::task_param_bag_mixed_modes_persist::971cdb92",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Task builders still use oversized mixed-mode param bags, forcing runtime branching instead of explicit mode contracts.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "src/shared/lib/tasks/joinClips.ts",
          "src/shared/lib/tasks/individualTravelSegment.ts",
          "src/shared/lib/tasks/travelBetweenImages/payloadBuilder.ts"
        ],
        "evidence": [
          "`JoinClipsTaskParams` includes legacy and new input shapes plus video-edit-only and orchestration fields in one type (`joinClips.ts:66-117`).",
          "`IndividualTravelSegmentParams` accepts both replayed raw payload (`originalParams`) and override values for nearly every field (`individualTravelSegment.ts:43-97`).",
          "`buildTravelBetweenImagesPayload` composes one mutable object with many conditional mode switches (`advanced_mode`, pair overrides, structure fields), rather than narrowing with discriminated unions (`payloadBuilder.ts:113-217`)."
        ],
        "suggestion": "Split each task family into discriminated input contracts (for example `mode: 'legacy_join' | 'multi_clip' | 'video_edit'`, `source: 'orchestrator_replay' | 'manual_override'`) and route to mode-specific payload builders. Keep one adapter layer for backward compatibility, but isolate it at module boundaries and emit a single canonical payload schema.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T20:25:15+00:00",
      "last_seen": "2026-02-24T20:25:15+00:00",
      "resolved_at": "2026-02-24T20:29:05+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::abstraction_fitness::task_payload_schema_drift_fallback_chains::ee377b73": {
      "id": "review::.::holistic::abstraction_fitness::task_payload_schema_drift_fallback_chains::ee377b73",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Multiple consumers depend on fallback chains across duplicate payload paths, indicating a drifting, non-canonical task param interface.",
      "detail": {
        "holistic": true,
        "dimension": "abstraction_fitness",
        "related_files": [
          "src/shared/components/TaskDetails/VideoTravelDetails.tsx",
          "src/tools/travel-between-images/components/ShotImagesEditor/hooks/useShotImagesEditorCallbacks.ts",
          "supabase/functions/complete_task/orchestrator.ts"
        ],
        "evidence": [
          "`VideoTravelDetails` resolves the same logical fields from several locations (`individual_segment_params`, `orchestrator_payload`, `orchestrator_details`, top-level), including advanced-mode and prompt fields (`VideoTravelDetails.tsx:77-187`).",
          "`useShotImagesEditorCallbacks` checks `pair_shot_generation_id` in FK column and two nested JSON paths (`params` + `individual_segment_params`) during deletion logic (`useShotImagesEditorCallbacks.ts:56-80`).",
          "Orchestrator completion logic still reads expected segment counts from both nested and top-level keys (`orchestrator_details.num_new_segments_to_generate` and `num_new_segments_to_generate`) (`orchestrator.ts:45-61`)."
        ],
        "suggestion": "Define and enforce a single versioned task-params schema per task family, then add a one-time normalization adapter when reading legacy rows. After normalization, downstream modules should read only canonical fields to remove fallback probing.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T20:25:15+00:00",
      "last_seen": "2026-02-24T20:25:15+00:00",
      "resolved_at": "2026-02-24T20:29:05+00:00",
      "reopen_count": 0,
      "lang": "typescript",

    "review::.::holistic::low_level_elegance::edit_state_projection_duplication::6fa5e10a": {
      "id": "review::.::holistic::low_level_elegance::edit_state_projection_duplication::6fa5e10a",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Inline edit state is projected into multiple overlapping shapes, increasing drift risk.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "src/tools/edit-images/hooks/useInlineEditState.ts",
          "src/tools/edit-images/components/InlineEditView.tsx",
          "src/shared/components/MediaLightbox/ImageLightbox.tsx"
        ],
        "evidence": [
          "`useInlineEditState` constructs a very large `imageEditValue` object, then separately returns `inpaintingState`, `transformState`, and `generationState` with many of the same sources/functions.",
          "Consumers such as `InlineEditView` and lightbox panels remap these same handlers/fields again, creating multiple manual mapping layers for one feature surface."
        ],
        "suggestion": "Define one canonical edit view-model contract and expose narrow selectors (for panel/canvas/actions) derived from that contract, instead of rebuilding parallel object graphs in each layer.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

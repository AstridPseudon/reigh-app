    "review::.::holistic::low_level_elegance::inline_edit_context_identity_churn::504639ed": {
      "id": "review::.::holistic::low_level_elegance::inline_edit_context_identity_churn::504639ed",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Inline edit state builds a huge context value object per render, forcing broad rerender churn and making behavior harder to reason about.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "src/tools/edit-images/hooks/useInlineEditState.ts",
          "src/tools/edit-images/components/InlineEditView.tsx",
          "src/shared/components/MediaLightbox/components/layouts/LightboxLayout.tsx"
        ],
        "evidence": [
          "`useInlineEditState` constructs `imageEditValue` as a large inline object (`lines 344-421`) without `useMemo`, then returns it.",
          "`InlineEditView` passes that object to `<ImageEditProvider value={state.imageEditValue}>` (`line 109`), so any parent re-render creates a new provider value identity.",
          "Downstream lightbox/layout code consumes image-edit context heavily; unstable provider identity widens rerender scope across overlay/tooling components."
        ],
        "suggestion": "Extract a dedicated selector-based context model or memoize `imageEditValue` with stable callbacks/segments (`canvas`, `drawing`, `generation`) so provider value identity only changes when relevant slices change.",
        "reasoning": ""
      },

    "review::.::holistic::authorization_consistency::completion_auth_contract_mismatch::a9f6871f": {
      "id": "review::.::holistic::authorization_consistency::completion_auth_contract_mismatch::a9f6871f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Sibling completion flows use inconsistent auth precondition contracts",
      "detail": {
        "holistic": true,
        "dimension": "authorization_consistency",
        "related_files": [
          "supabase/functions/complete_task/generation.ts",
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/calculate-task-cost/index.ts"
        ],
        "evidence": [
          "`createGenerationFromTask` accepts optional `authContext` and substitutes a fallback unauthenticated object before assertion.",
          "`checkOrchestratorCompletion` requires `authContext` from the caller and asserts that required context directly.",
          "`calculate-task-cost` enforces authenticate-and-authorize at handler entry with service-role requirement."
        ],
        "suggestion": "Make `authContext` mandatory in `createGenerationFromTask` and align complete-task internal call sites to a single explicit auth precondition pattern (no fabricated fallback context objects).",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

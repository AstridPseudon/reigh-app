    "review::.::holistic::logic_clarity::variant_delay_promise_leak::2e31c20f": {
      "id": "review::.::holistic::logic_clarity::variant_delay_promise_leak::2e31c20f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Overlapping variant invalidations for the same generation can leave earlier calls awaiting forever.",
      "detail": {
        "holistic": true,
        "dimension": "logic_clarity",
        "related_files": [
          "src/shared/hooks/invalidation/useGenerationInvalidation.ts",
          "src/shared/hooks/invalidation/__tests__/useGenerationInvalidation.test.ts"
        ],
        "evidence": [
          "`waitForVariantDelay` clears a prior timeout from `variantInvalidationTimeouts` (lines ~100-104) but does not resolve the Promise created by the prior invocation.",
          "The only resolve path is inside the timeout callback (lines ~112-116), so clearing that timeout strands the previous await permanently.",
          "No test covers two concurrent `invalidateVariantChange` calls sharing the same `generationId` with delay."
        ],
        "suggestion": "Store and cancel with resolver-aware entries (timeoutId + resolve/reject) so superseded waits complete deterministically, and add a regression test for two overlapping calls on the same generation key.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-24T17:37:02+00:00",

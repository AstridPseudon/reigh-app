    "review::.::holistic::api_surface_coherence::operation_result_semantics_diverge::58a025af": {
      "id": "review::.::holistic::api_surface_coherence::operation_result_semantics_diverge::58a025af",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Shared `OperationResult` APIs encode failures inconsistently, so callers cannot treat `ok` uniformly across edge helpers.",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "supabase/functions/_shared/rateLimit.ts",
          "supabase/functions/_shared/edgeRequest.ts",
          "supabase/functions/_shared/billing.ts",
          "supabase/functions/_shared/edgeOperation.ts"
        ],
        "evidence": [
          "`checkRateLimit` returns `operationSuccess(...)` even when rate limiting fails (`allowed: false`) and even when RPC/runtime errors occur (fail-open degraded path).",
          "`parseJsonBody`/`ensureRequestMethod` return `operationFailure(...)` on invalid request shape/method, and `triggerCostCalculation` returns `operationFailure(...)` on invalid downstream payloads.",
          "All of these use the same `OperationResult` type family, but the meaning of `ok` changes by module."
        ],
        "suggestion": "Define one explicit contract for `OperationResult`: either (a) `ok=false` always means operation-level failure (including RPC/runtime errors), and domain outcomes stay in `value`; or (b) split into dedicated result types (`RateLimitDecision`, `ParseResult`, etc.) instead of reusing a single generic envelope with divergent semantics.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T03:40:37+00:00",

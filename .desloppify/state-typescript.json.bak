    "review::.::holistic::low_level_elegance::task_cost_parser_reinjects_raw::2bf0e99b": {
      "id": "review::.::holistic::low_level_elegance::task_cost_parser_reinjects_raw::2bf0e99b",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Task-cost param parser re-introduces unvalidated raw fields after normalization, weakening type guarantees at the billing boundary.",
      "detail": {
        "holistic": true,
        "dimension": "low_level_elegance",
        "related_files": [
          "supabase/functions/calculate-task-cost/index.ts",
          "supabase/functions/complete_task/generation.ts"
        ],
        "evidence": [
          "`parseTaskCostParams` normalizes `resolution/frame_count/model_type/result`, then loops through original record and assigns `parsed[key] = rawValue` whenever key is not currently in `parsed`.",
          "If a known field fails normalization (e.g., malformed numeric values), it is effectively passed through as raw fallback data, undermining the parser\u2019s contract.",
          "In contrast, `complete_task/generation.ts` uses explicit normalization (`asObjectOrEmpty`, string checks) and does not re-insert invalidly typed values by default."
        ],
        "suggestion": "Make parser behavior explicit: preserve unknown keys only in a dedicated `extras` bucket, and never re-add known billing keys unless they pass typed validation. Add a unit test for malformed `frame_count`/`model_type` payloads to lock behavior.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "parseTaskCostParams no longer re-injects malformed known billing keys and tests cover malformed frame_count/model_type/result behavior",

    "review::.::holistic::convention_outlier::tooltip_entrypoint_drift::679d3367": {
      "id": "review::.::holistic::convention_outlier::tooltip_entrypoint_drift::679d3367",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Tooltip primitives are consumed through inconsistent sibling entrypoints",
      "detail": {
        "holistic": true,
        "dimension": "convention_outlier",
        "related_files": [
          "src/shared/components/ui/touchableTooltip.tsx",
          "src/shared/components/ui/tooltip.tsx",
          "src/shared/components/ui/tooltipPrimitives.tsx"
        ],
        "evidence": [
          "`TouchableTooltip` imports tooltip primitives from local `./tooltipPrimitives`.",
          "Other UI modules consume tooltip via the shared barrel (`@/shared/components/ui/tooltip`) that re-exports from `primitives/tooltip`."
        ],
        "suggestion": "Standardize on one tooltip import surface for UI consumers (prefer the shared barrel), and remove/bound alternate primitive paths unless they are explicitly versioned for different behavior.",
        "reasoning": ""

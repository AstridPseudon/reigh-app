    "review::.::holistic::mid_level_elegance::lightbox_mode_ref_lag::c452b7f4": {
      "id": "review::.::holistic::mid_level_elegance::lightbox_mode_ref_lag::c452b7f4",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Image lightbox shares edit-mode state through mutable refs, producing stale cross-hook handoff values.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/components/MediaLightbox/ImageLightbox.tsx",
          "src/shared/components/MediaLightbox/components/layouts/LightboxLayout.tsx"
        ],
        "evidence": [
          "In `ImageLightbox.tsx`, `useImageLightboxSharedState` consumes `isMagicEditModeRef.current`/`isInpaintModeRef.current` for `swipeDisabled` and special-edit flags.",
          "Those refs are assigned later in `useImageLightboxEditing` (`isInpaintModeRef.current = editOrchestrator.isInpaintMode; isMagicEditModeRef.current = editOrchestrator.isMagicEditMode;`).",
          "Because the shared state reads happen before assignment in the same render, seam data can lag by one render and desynchronize gesture/navigation behavior under edit-mode transitions."
        ],
        "suggestion": "Replace ref-based handoff with state-driven handoff: derive shared flags directly from `editOrchestrator` output (or compute a unified model hook that builds shared+edit state together) so `swipeDisabled` and layout flags are render-consistent.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

    "review::.::holistic::mid_level_elegance::state_bag_seams_in_lightbox_and_inline_edit::7eeccf01": {
      "id": "review::.::holistic::mid_level_elegance::state_bag_seams_in_lightbox_and_inline_edit::7eeccf01",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "medium",
      "summary": "Edit/lightbox seams rely on oversized state bags and ref-mediated handoffs instead of narrow contracts.",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "src/shared/components/MediaLightbox/ImageLightbox.tsx",
          "src/tools/edit-images/hooks/useInlineEditState.ts",
          "src/tools/edit-images/components/InlineEditView.tsx",
          "src/shared/components/MediaLightbox/components/layouts/LightboxLayout.tsx"
        ],
        "evidence": [
          "`ImageLightbox` creates `isInpaintModeRef`/`isMagicEditModeRef` in shared-state setup and passes their `.current` values into `useSharedLightboxState` before writing updated values later in `useImageLightboxEditing` (`ImageLightbox.tsx` lines 226-279, 358-359).",
          "`useInlineEditState` constructs large mapped contracts (`buildInlineEditStateModels`) and then returns another broad contract (`InlineEditStateResult`), with downstream forwarding in `InlineEditView` into `EditModePanel` and canvas controls.",
          "`LightboxLayout` conditionally renders core UI behavior from these propagated mode flags (`isSpecialEditMode`, edit mode), so stale or over-broad seam state directly affects layout behavior."
        ],
        "suggestion": "Split edit/lightbox seams into focused view-model contracts per concern (navigation, variant ops, edit-mode, render-only media state). Replace ref-mediated mode handoff with explicit state derived once in the orchestrator and passed as immutable snapshot props/context per render.",
        "reasoning": ""
      },
      "status": "fixed",
      "note": "Replaced ImageLightbox ref-mediated mode handoff with explicit edit-mode snapshot state synchronized from orchestrator output, and narrowed inline edit seams via dedicated canvas/sidebar view-model contracts. This removes stale-ref risk and reduces oversized state-bag propagation across lightbox/edit boundaries.",
      "first_seen": "2026-02-25T17:35:53+00:00",
      "last_seen": "2026-02-25T17:35:53+00:00",
      "resolved_at": "2026-02-25T19:19:49+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null,
      "resolution_attestation": {
        "kind": "manual",
        "text": "I have actually removed the ref-mediated seam and narrowed edit/lightbox contracts and I am not gaming the score by resolving without fixing.",
        "attested_at": "2026-02-25T19:19:49+00:00",
        "scan_verified": false
      }
    },

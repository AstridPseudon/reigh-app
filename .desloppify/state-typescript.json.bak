    "review::.::holistic::high_level_elegance::supabase_client_multi_role_facade::7d012161": {
      "id": "review::.::holistic::high_level_elegance::supabase_client_multi_role_facade::7d012161",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Supabase client entrypoint mixes bootstrap lifecycle, recovery policy, and legacy API compatibility into one ownership boundary.",
      "detail": {
        "holistic": true,
        "dimension": "high_level_elegance",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/shared/lib/errorHandling/handleError.ts"
        ],
        "evidence": [
          "src/integrations/supabase/client.ts handles initialization (`initializeSupabase`), lazy fallback recovery in `getSupabaseClient`, dev warning policy, and exports a method-by-method legacy facade with deprecation metadata.",
          "The module also directly encodes migration-governance constants (`LEGACY_SUPABASE_ALIAS_REMOVE_BY`, owner) and operational error routing via `handleError`, making it both runtime adapter and migration coordinator."
        ],
        "suggestion": "Split into explicit modules: a minimal runtime accessor, a bootstrap initializer, and a temporary legacy adapter module (re-exported only where needed). Keep deprecation/governance metadata in the legacy adapter so the main runtime client has one responsibility.",
        "reasoning": ""
      },
      "status": "auto_resolved",

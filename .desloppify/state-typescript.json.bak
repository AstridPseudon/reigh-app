    "review::.::holistic::mid_level_elegance::orchestrator_completion_not_idempotent_for_billing::4c2e2d8f": {
      "id": "review::.::holistic::mid_level_elegance::orchestrator_completion_not_idempotent_for_billing::4c2e2d8f",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Orchestrator completion can trigger billing side effects even when status update no-ops",
      "detail": {
        "holistic": true,
        "dimension": "mid_level_elegance",
        "related_files": [
          "supabase/functions/complete_task/orchestrator.ts",
          "supabase/functions/_shared/billing.ts",
          "supabase/functions/_shared/edgeOperation.ts"
        ],
        "evidence": [
          "`markOrchestratorComplete` performs `.update(...).eq(\"id\", orchestratorTaskId).in(\"status\", [\"Queued\", \"In Progress\"])` and only checks `error`, not whether any row matched.",
          "After that, it always calls `triggerCostCalculation` and `persistBillingOutcome`.",
          "In concurrent completions, a second caller can miss the update precondition yet still execute external billing/reconciliation writes."
        ],
        "suggestion": "Make completion side effects conditional on a confirmed state transition (for example require `update(...).select('id').single()` or `count` check, and return early when 0 rows updated). Add an idempotency key/guard around `triggerCostCalculation` to prevent duplicate billing triggers.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "Disappeared from scan \u2014 likely fixed",

    "review::.::holistic::api_surface_coherence::pending_clip_action_contract_is_misleading::3dce84aa": {
      "id": "review::.::holistic::api_surface_coherence::pending_clip_action_contract_is_misleading::3dce84aa",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Join-clips pending action API documents discriminated actions but exports only opaque clip payloads.",
      "detail": {

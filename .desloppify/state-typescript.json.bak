    "review::.::holistic::initialization_coupling::supabase_ambient_singleton_dependency::eeb26466": {
      "id": "review::.::holistic::initialization_coupling::supabase_ambient_singleton_dependency::eeb26466",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Supabase access is ambient and bootstrap-dependent, coupling many hooks/services to a hidden global init sequence.",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "src/integrations/supabase/client.ts",
          "src/integrations/supabase/runtime/supabaseRuntime.ts",
          "src/app/bootstrap.tsx",
          "src/shared/services/projects/projectSetupService.ts",
          "src/pages/Home/hooks/useHomeAuth.ts"
        ],
        "evidence": [
          "client.ts throws when getSupabaseClient() is called before initializeSupabase(), encoding a hard runtime ordering dependency.",
          "Many domain/service modules import getSupabaseClient as supabase and call supabase() directly, so these modules implicitly require app bootstrap to have executed.",
          "bootstrap.tsx performs initializeSupabase() as side-effectful environment setup, making correctness dependent on app entrypoint order rather than explicit dependency injection."
        ],
        "suggestion": "Introduce a typed runtime registry/context (or provider) that owns Supabase lifecycle and inject client into services/hooks; reserve throwing accessor for legacy adapters only and migrate call sites incrementally.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-03-02T10:11:09+00:00",
      "last_seen": "2026-03-02T10:11:09+00:00",
      "resolved_at": "2026-03-02T11:38:16+00:00",
      "reopen_count": 0,
      "lang": "typescript",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::initialization_coupling::scattered_debug_window_globals::f8884231": {
      "id": "review::.::holistic::initialization_coupling::scattered_debug_window_globals::f8884231",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Dev diagnostics expose multiple mutable window globals without a single registry, creating last-writer-wins and stale-reference risk during long-lived dev sessions/HMR.",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "src/integrations/supabase/debug/initializeSupabaseDebugGlobals.ts",
          "src/shared/realtime/DataFreshnessManager.ts",
          "src/shared/services/network/networkStatusDebug.ts",
          "src/integrations/supabase/reconnect/ReconnectScheduler.ts"
        ],
        "evidence": [
          "Separate modules assign different manager/client instances directly onto window (__supabase_client__, __DATA_FRESHNESS_MANAGER__, __NETWORK_STATUS_MANAGER__, __RECONNECT_SCHEDULER__).",
          "No shared registration/cleanup contract exists, so repeated initialization paths can overwrite globals without lifecycle validation."
        ],
        "suggestion": "Centralize dev global exposure in one debug registry module with versioned keys, duplicate-registration guards, and teardown hooks for HMR/test isolation.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",

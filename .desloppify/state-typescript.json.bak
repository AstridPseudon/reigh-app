    "review::.::holistic::cross_module_architecture::legacy_facade_paths_remain_primary_dependency::c3eb0ca3": {
      "id": "review::.::holistic::cross_module_architecture::legacy_facade_paths_remain_primary_dependency::c3eb0ca3",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "high",
      "summary": "Deprecated error/supabase facades are still first-class dependency hubs across runtime code.",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/shared/lib/errorHandling/handleError.ts",
          "src/integrations/supabase/legacy/legacySupabaseFacade.ts",
          "src/shared/components/MediaGallery/hooks/useMediaGalleryHandlers.ts",
          "src/shared/components/MediaGalleryItem/hooks/useMediaGalleryItemState.ts"
        ],
        "evidence": [
          "`handleError.ts` keeps deprecated compatibility exports (`reportRuntimeError`, `RuntimeErrorOptions`) live, so old call sites continue to compile unchanged.",
          "`legacySupabaseFacade.ts` still exposes deprecated `getLegacySupabaseClient()` with lifecycle policy metadata and runtime warning, indicating the shim is still in active path rather than isolated migration edge.",
          "Assigned gallery hooks import and depend on the central error facade directly, reinforcing hub coupling from feature code into a compatibility-heavy shared entrypoint."
        ],
        "suggestion": "Enforce a shrinking adapter boundary: keep compatibility exports only in migration-only entry modules, migrate feature call sites to canonical APIs (`handleError` only, runtime supabase client only), then block new imports via lint rule/path ban and remove legacy exports when import count reaches zero.",
        "reasoning": ""
      },
      "status": "auto_resolved",
      "note": "not reported in latest holistic re-import",
      "first_seen": "2026-02-25T01:47:30+00:00",
      "last_seen": "2026-02-25T01:47:30+00:00",
